end	

function barter_bloodsuckerjaw()
	if level.get_time_hours() >= 12 and level.get_time_hours() <= 23 then
	return multiple_objects ("mutant_krovosos_jaw",1)
	end
end	

function monster_parts_barter()
	if level.get_time_hours() >= 0 and level.get_time_hours() <= 11 then
		db.actor:give_talk_message("%c[red]x3 %c[default]ìåíÿþ íà %c[green]x1 Ïàòðîíû 9x18 ìì ÏÁÌ", "ui\\ui_icon_equipment",Frect():set(450,50,50,50),"iconed_barter_menu")
		db.actor:give_talk_message("%c[red]x2 %c[default]ìåíÿþ íà %c[green]x2 Ïàòðîíû 12x70 êàðòå÷ü", "ui\\ui_icon_equipment",Frect():set(550,50,50,50),"iconed_barter_menu")
		db.actor:give_talk_message("%c[red]x3 %c[default]ìåíÿþ íà %c[green]x3 Ïàòðîíû 12x70 äðîáü", "ui\\ui_icon_equipment",Frect():set(400,950,50,50),"iconed_barter_menu")
	elseif level.get_time_hours() >= 12 and level.get_time_hours() <= 23 then
		db.actor:give_talk_message("%c[red]x2 %c[default]ìåíÿþ íà %c[green]x3 Ïàòðîíû 12õ70 êàðòå÷ü", "ui\\ui_icon_equipment",Frect():set(450,950,50,50),"iconed_barter_menu")
		db.actor:give_talk_message("%c[red]x1 %c[default]ìåíÿþ íà %c[green]x1 Ïàòðîíû 5,45x39 ìì Ðàçðûâíîé", "ui\\ui_icon_equipment",Frect():set(850,100,50,50),"iconed_barter_menu")
	end
end

function dogtails_ammo(first_speaker, second_speaker)
	dialogs.relocate_item_section(first_speaker, "mutant_dog_tail", "out")
	dialogs.relocate_item_section(first_speaker, "mutant_dog_tail", "out")
	dialogs.relocate_item_section(first_speaker, "mutant_dog_tail", "out")
	dialogs.relocate_item_section(first_speaker, "ammo_9x18_pbp", "in")
end

