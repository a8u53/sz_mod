function boarlegs_remove()
    local cnt = db.actor:object_count()
    local ch=0
    for i=0, cnt-1 do
        local item = db.actor:object(i)
        if item:section() == "mutant_boar_leg" then
            local sobj = alife():object(item:id())
            if sobj then
                alife():release(sobj,true)
                ch = ch+1
                if ch == 2 then --7 - ÐºÐ¾Ð»-Ð²Ð¾ ÑƒÐ´Ð°Ð»ÑÐµÐ¼Ñ‹Ñ… Ð°Ð¿Ñ‚ÐµÑ‡ÐµÐº
                break end
            end
        end
    end
end

