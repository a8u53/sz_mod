-- ============================================================
-- sz_healing.script
-- Менеджер активных эффектов лечения
-- ============================================================

-- ============================================================
-- НАСТРОЙКИ БАЛАНСА (крути тут)
-- ============================================================
local RATE_HEALTH    = 0.05   -- 5% здоровья в секунду
local RATE_RADIATION = 0.10   -- 10% радиации в секунду
local RATE_POWER     = 0.20   -- 20% выносливости в секунду

local BLINK_TIME  = 3000      -- За 3 секунды до конца мигать
local BLINK_SPEED = 200       -- Частота мигания (мс)

-- ============================================================
-- ТАБЛИЦА ПРЕДМЕТОВ
-- static: основной статик
-- static_rad: дополнительный статик для радиации (если есть)
-- ============================================================
local ITEMS = {
    -- АПТЕЧКИ
    ["medkit"] = { 
        time = 5000, 
        static = "hud_heal_medkit", 
        static_rad = nil,
        health = true, radiation = false, power = false 
    },
    ["medkit_army"] = { 
        time = 10000, 
        static = "hud_heal_medkit", 
        static_rad = nil,
        health = true, radiation = false, power = false 
    },
    ["medkit_scientic"] = { 
        time = 20000, 
        static = "hud_heal_medkit", 
        static_rad = "hud_heal_antirad", -- Научная аптечка вешает два статика
        health = true, radiation = true, power = false 
    },
    
    -- АНТИРАД
    ["antirad"] = { 
        time = 10000, 
        static = "hud_heal_antirad", 
        static_rad = nil,
        health = false, radiation = true, power = false 
    },
    ["antirad_pills"] = { 
        time = 5000, 
        static = "hud_heal_antirad", 
        static_rad = nil,
        health = false, radiation = true, power = false 
    },
    
    -- ОБЕЗБОЛИВАЮЩИЕ
    ["painkiller_1"] = { time = 2000, static = "hud_heal_medkit", static_rad = nil, health = true, radiation = false, power = false },
    ["painkiller_2"] = { time = 2000, static = "hud_heal_medkit", static_rad = nil, health = true, radiation = false, power = false },
    ["painkiller_3"] = { time = 2000, static = "hud_heal_medkit", static_rad = nil, health = true, radiation = false, power = false },
    ["painkiller_4"] = { time = 2000, static = "hud_heal_medkit", static_rad = nil, health = true, radiation = false, power = false },
    
    -- ЭНЕРГЕТИКИ
    ["energy_drink"] = { 
        time = 5000, 
        static = "hud_heal_energy", 
        static_rad = nil,
        health = false, radiation = false, power = true 
    },
    ["voda"] = { 
        time = 3000, 
        static = "hud_heal_energy", 
        static_rad = nil,
        health = false, radiation = false, power = true 
    },
    ["vodka"] = { 
        time = 10000, 
        static = "hud_heal_energy", 
        static_rad = nil,
        health = false, radiation = true, power = false 
    },
}

-- ============================================================
-- МЕНЕДЖЕР ЭФФЕКТОВ
-- ============================================================

local active_effects = {}
local last_time = 0

function is_heal_item(section)
    return ITEMS[section] ~= nil
end

local function get_static_wnd(hud, static_name)
    if not hud or not static_name then return nil end
    local static = hud:GetCustomStatic(static_name)
    if not static then
        hud:AddCustomStatic(static_name, true)
        static = hud:GetCustomStatic(static_name)
    end
    if not static then return nil end
    return static.wnd and static:wnd() or nil
end

local function remove_static(hud, static_name)
    if hud and static_name and hud:GetCustomStatic(static_name) then
        hud:RemoveCustomStatic(static_name)
    end
end

function reset_healing()
    local hud = get_hud()
    for _, effect in pairs(active_effects) do
        remove_static(hud, effect.static_name)
        if effect.static_rad then
            remove_static(hud, effect.static_rad)
        end
    end
    active_effects = {}
    last_time = 0
end

function use_item(obj)
    if not obj then return end
    local section = obj:section()
    local item_data = ITEMS[section]
    
    if not item_data then return end
    
    local actor = db.actor
    if not actor or not actor:alive() then return end

    -- Ключ эффекта - основной статик. Если пьешь антирад, ключ "hud_heal_antirad".
    -- Если пьешь научную аптечку, ключ "hud_heal_medkit".
    local effect_key = item_data.static

    -- Если такой эффект уже есть, мы его перезапускаем
    active_effects[effect_key] = {
        time_left = item_data.time,
        static_name = item_data.static,
        static_rad = item_data.static_rad,
        health = item_data.health,
        radiation = item_data.radiation,
        power = item_data.power,
        next_tick_time = time_global() + 1000,
        blink_timer = 0,
        is_visible = true
    }
    
    if last_time == 0 then
        last_time = time_global()
    end
end

function update_healing()
    if next(active_effects) == nil then 
        last_time = 0
        return 
    end

    local actor = db.actor
    if not actor or not actor:alive() then
        reset_healing()
        return
    end

    local now = time_global()
    if last_time == 0 then last_time = now end
    
    local delta = now - last_time
    last_time = now
    if delta > 1000 then delta = 1000 end -- Защита от лагов

    local hud = get_hud()
    local to_remove = {}

    for key, effect in pairs(active_effects) do
        effect.time_left = effect.time_left - delta

        -- Визуал
        local wnd = get_static_wnd(hud, effect.static_name)
        local wnd_rad = get_static_wnd(hud, effect.static_rad)
        
        local show = true
        if effect.time_left <= BLINK_TIME then
            effect.blink_timer = effect.blink_timer + delta
            if effect.blink_timer >= BLINK_SPEED then
                effect.blink_timer = 0
                effect.is_visible = not effect.is_visible
            end
            show = effect.is_visible
        end
        
        if wnd then wnd:Show(show) end
        if wnd_rad then wnd_rad:Show(show) end

        -- Эффекты (раз в секунду)
        if now >= effect.next_tick_time then
            effect.next_tick_time = now + 1000
            
            if effect.health then
                actor.health = math.min(actor.health + RATE_HEALTH, 1.0)
            end
            if effect.radiation then
                -- В OGSR радиация может быть в диапазоне 0..1 или 0..100
                -- Обычно 0..1. Если у тебя 0..100, убери деление на 1.0
                actor.radiation = math.max(actor.radiation - RATE_RADIATION, 0.0)
            end
            if effect.power then
                actor.power = math.min(actor.power + RATE_POWER, 1.0)
            end
        end

        -- Завершение
        if effect.time_left <= 0 then
            table.insert(to_remove, key)
        end
    end

    for _, key in ipairs(to_remove) do
        local effect = active_effects[key]
        remove_static(hud, effect.static_name)
        if effect.static_rad then
            remove_static(hud, effect.static_rad)
        end
        active_effects[key] = nil
    end
end