---------------Продажа документов----------------------------------------
function money_maker_1_check(task, objective)
return db.actor:object("money_maker_1")
end

function money_maker_2_check(task, objective)
return db.actor:object("money_maker_2")
end

function money_maker_3_check(task, objective)
return db.actor:object("money_maker_3")
end

function relocate_1(first_speaker, second_speaker)
	dialogs.relocate_item_section(second_speaker, "money_maker_1", "out")
end
function relocate_2(first_speaker, second_speaker)
	dialogs.relocate_item_section(second_speaker, "money_maker_2", "out")
end
function relocate_3(first_speaker, second_speaker)
	dialogs.relocate_item_section(second_speaker, "money_maker_3", "out")
end
		
function money_maker_reward()
local reward = math.random (400,1500)
	db.actor:give_talk_message(reward .. " RU", "ui\\ui_iconstotal",Frect():set(0,0,83,47),"iconed_trade_info")
	db.actor:give_money(reward)
end
