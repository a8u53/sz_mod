--Пьяный хуй
function drunken_bastard()
local npc = level_object_by_sid(884)
local snd = xr_sound.get_safe_sound_object( [[characters_voice\scenario\bar\bar_visitor\bar_visitor_13]] )
snd:play_at_pos(npc, vector ():set (0, 0, 0), 5, sound_object.s2d)
end