local post_message_prob = 1 -- 1 - работает , 0 - вылет!

local prob1 = news_main.show_news_trade
local prob2 = news_main.show_news_another
local prob3 = news_main.show_news_dolg
local prob4 = news_main.show_news_freedom
local prob5 = news_main.show_news_random
local prob6 = news_main.show_death_news

local time = time_global()
local last_morning_day = -1
local last_evening_day = -1

--Главная функция
function show_news_main()
    if (isIsolatedLevel(level.name()) == true) then return end

    local uptime = time_global()

    -- Утренние сообщения: 04:30 – 07:00, раз в игровой день
    local hour = level.get_time_hours()
    local minute = level.get_time_minutes()
    local now_day = level.get_time_days()
    local minutes_of_day = hour * 60 + minute

    if minutes_of_day >= 270 and minutes_of_day <= 420 and last_morning_day ~= now_day then
        last_morning_day = now_day
        morning_templates()
        return
    end

    -- Вечерние сообщения: 20:30 – 22:00, раз в игровой день
    if minutes_of_day >= 1230 and minutes_of_day <= 1320 and last_evening_day ~= now_day then
        last_evening_day = now_day
        evening_templates()
        return
    end

    -- Обычные рандомные новости
    if uptime <= time then return else
        time = time + math.random(90000, 250000) -- срабатывает рандомно
    end

    local ft = {
        prob1,
        prob2,
        prob3,
        prob4,
        prob5,
        prob6
    }
    ft[math.random(#ft)]()
end

--"Статус соединения:"
local connect_templates = {
	"%c[255,160,255,160]Система:\\n%c[default]Связь установлена.",
	"%c[255,160,255,160]Система:\\n%c[default]Приём сигнала возобновлён.",
	"%c[255,160,255,160]Система:\\n%c[default]Подключение к сети...",
	"%c[255,160,255,160]Система:\\n%c[default]Уровень сигнала восстановлен.",
	"%c[255,160,255,160]Система:\\n%c[default]Подключение к серверу..."
}

local disconnect_templates = {
	"%c[255,160,255,160]Система:\\n%c[default]Нет подключения к серверу.",
	"%c[255,160,255,160]Система:\\n%c[default]Связь прервана.",
	"%c[255,160,255,160]Система:\\n%c[default]Низкий уровень сигнала.",
	"%c[255,160,255,160]Система:\\n%c[default]Прием невозможен, связь потеряна.",                  
	"%c[255,160,255,160]Система:\\n%c[default]Сигнал отсутствует."
}

--Вспомагательный функции
function on_connect()
    local msg = ""
    if math.random() < post_message_prob then
        msg = connect_templates[math.random(#connect_templates)]
    end
    if (msg ~= "") then
        db.actor:give_game_news(msg, "ui\\ui_iconsTotal", Frect():set(83,94,83,47), 0, 13000)
    end
end

function on_disconnect()
    local msg = ""
    if math.random() < post_message_prob then
        msg = disconnect_templates[math.random(#disconnect_templates)]
    end
    if (msg ~= "") then
        db.actor:give_game_news(msg, "ui\\ui_iconsTotal", Frect():set(83,94,83,47), 0, 13000)
    end
end

-- 04:30 - 07:00
