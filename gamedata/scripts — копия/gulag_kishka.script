function load_states(gname, type)
	
	if type == "ds2_lager_st" then
		return function(gulag)
			return 0
		end
    end
	
	if type == "ds2_domik_st" then
		return function(gulag)
			return 0
		end
    end
	
	if type == "ds_boars_nest" then
		return function(gulag)
			return 0
		end
	end
	
	if type == "ds_boars_nest1" then
		return function(gulag)
			return 0
		end
	end
	if type == "ds_boars_nest2" then
		return function(gulag)
			return 0
		end
	end
	
end

