function load_ltx(gname, type)
	return nil
end

function checkStalker(npc_community, gulag_type)

	if gulag_type == "ds2_lager_st" then
	   return true
	end
	
	if gulag_type == "ds2_domik_st" then
	   return true
	end
	return false
end

function checkMonster(npc_community, gulag_type)
	if gulag_type == "ds_boars_nest" then
			return npc_community == "boar"
	end
	if gulag_type == "ds_boars_nest1" then
			return npc_community == "boar"
	end
	if gulag_type == "ds_boars_nest2" then
			return npc_community == "boar"
	end
	return false
	
end