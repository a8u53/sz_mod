-- --- Звуки ---
local SND_POS = vector():set(0, 0, 0)
local snd_cache = {}

-- --- Цепочка таблеток ---
local painkiller_chain = {
    ["painkiller_4"] = "painkiller_3",
    ["painkiller_3"] = "painkiller_2",
    ["painkiller_2"] = "painkiller_1",
}

-- --- Выброс ---
local BLOWOUT_MIN_DAYS = 3
local BLOWOUT_MAX_DAYS = 10
local BLOWOUT_END_MS = 4 * 60 * 1000  -- 4 минуты

-- --- Параметры шкалы радиации ---
local FILL_PAD_X = 5
local FILL_PAD_W = 10
local RAD_MAX    = 1.0

local STATIC_BACK  = "hud_rad_back"
local STATIC_LEVEL = "hud_rad_level"

-- --- Кэш сообщества ---
local community = {
    ["stalker"] = "Вольный сталкер", ["monolith"] = "\"Монолит\"", ["military"] = "Военный",
    ["bandit"] = "Ренегат", ["killer"] = "Наемник", ["ecolog"] = "Ученый",
    ["dolg"] = "\"Долг\"", ["freedom"] = "\"Свобода\"", ["zombied"] = "Зомбированный",
    ["trader"] = "Торговец", ["arena_enemy"] = "Боец арены"
}

-- ============================================================
-- СЕКЦИЯ 2: НОВЫЕ ФУНКЦИИ
-- ============================================================

-- --- Статик брони ---
function armor_static()
    local actor = db.actor
    if not actor or not actor:alive() then return end
    local hud = get_hud()
    if not hud then return end

    local suit = actor:item_in_slot(6)
    local new_static = nil

    if suit then
        local cond = suit:condition() * 100
        if cond <= 60 and cond > 31 then
            new_static = "hud_show_armor"
        elseif cond <= 30 and cond > 11 then
            new_static = "hud_show_armor2"
        elseif cond <= 10 then
            new_static = "hud_show_armor3"
        end
    end

    if new_static == armor_last_static then return end
    armor_last_static = new_static

    local statics = {"hud_show_armor", "hud_show_armor2", "hud_show_armor3"}
    for _, s in ipairs(statics) do
        if hud:GetCustomStatic(s) then hud:RemoveCustomStatic(s) end
    end

    if new_static then hud:AddCustomStatic(new_static, true) end
end

-- ============================================================
-- Шкала радиации (статик виден всегда при наличии детектора)
-- ============================================================

local function has_detector(actor)
    if not actor then return false end
    return actor:object(DETECTOR_SECTION) ~= nil
end

local function hide_radiation_statics(hud)
    if not hud then return end
    if hud:GetCustomStatic(STATIC_BACK) then
        hud:RemoveCustomStatic(STATIC_BACK)
    end
    if hud:GetCustomStatic(STATIC_LEVEL) then
        hud:RemoveCustomStatic(STATIC_LEVEL)
    end
end

-- Возвращает wnd() статика или nil, если статик/окно невалидны.
-- При необходимости создаёт статик заново.
local function get_static_wnd(hud, static_name)
    if not hud then return nil end
    local static = hud:GetCustomStatic(static_name)
    if not static then
        hud:AddCustomStatic(static_name, true)
        static = hud:GetCustomStatic(static_name)
    end
    if not static then return nil end
    return static.wnd and static:wnd() or nil
end

-- Вызывается из bind_stalker:net_spawn()
function reset_radiation_hud()
    local hud = get_hud()
    if hud then
        hide_radiation_statics(hud)
    end
    rad_update_time = 0
end

function update_radiation()
    local actor = db.actor

    -- Мёртв / нет актора — прячем (HUD всё равно разрушается)
    if not actor or not actor:alive() then
        local hud = get_hud()
        if hud then hide_radiation_statics(hud) end
        return
    end

    -- Троттлинг 100 мс
    local current_time = time_global()
    if current_time - rad_update_time < 100 then return end
    rad_update_time = current_time

    local hud = get_hud()
    if not hud then return end

    -- Нет детектора — прячем
    if not has_detector(actor) then
        hide_radiation_statics(hud)
        return
    end

    -- Есть детектор — статики всегда на экране
    local back_wnd  = get_static_wnd(hud, STATIC_BACK)
    local level_wnd = get_static_wnd(hud, STATIC_LEVEL)

    if back_wnd then
        back_wnd:SetWndPos(BACK_X, BACK_Y)
        back_wnd:SetWidth(BACK_W)
        back_wnd:SetHeight(BACK_H)
    end

    if level_wnd then
        local radiation = actor.radiation or 0
        local rad_percent = 0
        if radiation > 0 then
            rad_percent = math.min(radiation / RAD_MAX, 1.0)
        end

        local fill_h = math.floor(rad_percent * BACK_H)
        local fill_y = BACK_Y + BACK_H - fill_h

        level_wnd:SetWndPos(BACK_X + FILL_PAD_X, fill_y)
        level_wnd:SetWidth(BACK_W - FILL_PAD_W)
        level_wnd:SetHeight(fill_h)
    end
end

-- --- Лут денег ---
function lootmoney(npc)
    if not npc then return end
    if npc:alive() then return end
    if IsMonster(npc) then return end
    local npc_id = npc:id()
    if looted_money[npc_id] then return end

    local section = npc:section()
    if string.find(section, "arena") then return end
    local ok, community_name = pcall(function() return npc:character_community() end)
    if ok and community_name == "arena_enemy" then return end

    local money = npc:money()
    if not money or money <= 0 then return end

    if math.random() < no_money_chance then looted_money[npc_id] = true; return end

    local deadmoney = money
    local npc_rank = ranks.get_obj_rank_name(npc)
    if npc_rank == "novice" and deadmoney > 300 then deadmoney = math.random(25, 85)
    elseif npc_rank == "beginner" and deadmoney > 400 then deadmoney = math.random(35, 100)
    elseif npc_rank == "experienced" and deadmoney > 500 then deadmoney = math.random(55, 150)
    elseif npc_rank == "veteran" and deadmoney > 600 then deadmoney = math.random(70, 235)
    elseif npc_rank == "master" and deadmoney > 700 then deadmoney = math.random(110, 325) end

    local news_text = "%c[255,160,160,160]" .. game.translate_string("st_tip") ..
        "\\n%c[255,255,255,255]Обнаружены деньги: %c[124,247,136,1]" ..
        tostring(deadmoney) .. "%c[default] руб."
    db.actor:give_game_news(news_text, "ui\\ui_iconsTotal", Frect():set(0, 0, 83, 47), 1, 3000)

    db.actor:give_money(deadmoney)
    npc:give_money(-money)
    game_stats.money_quest_update(deadmoney)
    looted_money[npc_id] = true
end

-- --- Время на экране ---
function show_time()
    local now = time_global()
    if now - last_time_update < time_update_interval then return end
    last_time_update = now

    local hud = get_hud()
    if not hud then return end

    local cs = hud:GetCustomStatic("hud_show_time")
    if not cs then
        hud:AddCustomStatic("hud_show_time", true)
        cs = hud:GetCustomStatic("hud_show_time")
    end
    if not cs then return end

    local wnd = cs.wnd and cs:wnd()
    if not wnd then return end

    wnd:SetText(string.format("%02d:%02d", level.get_time_hours(), level.get_time_minutes()))
end

-- --- Еда/таблетки ---
function start(obj)
    if not obj or not db.actor then return end
    local section = obj:section()
    local entry = item_use_table[section]
    if not entry then return end

    sound_obj_left = xr_sound.get_safe_sound_object(entry.sound)
    sound_obj_right = xr_sound.get_safe_sound_object(entry.sound)
    level.add_cam_effector("camera_effects\\inv_use.anm", 999, false, "")

    slotinuse = db.actor:active_slot()
    slot_div = 1
    holster_time = time_global() + entry.holster
    if objectinuse == 1 then holster_time = holster_time + entry.holster end
    soundhub()

    local actor = db.actor
    local pos = actor:position()
    local lvid = actor:level_vertex_id()
    local gvid = actor:game_vertex_id()
    local aid = actor:id()

    if entry.spawn then spawn_item(entry.spawn, SPAWN_OFFSET) end
    if entry.spawn_card then alife():create(cards[math.random(#cards)], pos, lvid, gvid, aid) end
    if entry.spawn_eatble then alife():create(eatbles[math.random(#eatbles)], pos, lvid, gvid, aid) end
    if entry.spawn_self then alife():create(entry.spawn_self, pos, lvid, gvid, aid) end
    if entry.psy then db.actor.psy_health = entry.psy end
end

function soundhub()
    if db.actor:alive() then
        sound_obj_left:play_at_pos(db.actor, vector():set(-1, 0, 0), 0, sound_object.s2d)
        sound_obj_right:play_at_pos(db.actor, vector():set(1, 0, 0), 0, sound_object.s2d)
        sound_obj_left = sound_object([[$no_sound]])
        sound_obj_right = sound_object([[$no_sound]])
        if objectinuse == 0 then
            db.actor:hide_weapon()
            objectinuse = 1
            if slotinuse == 1 then slot_div = ((holster_time - time_global()) / 1.5) else slot_div = 0 end
        end
        objectused = objectused + 1
        weapontimer()
    end
end

function weapontimer()
    if (holster_time ~= nil) and (time_global() > (holster_time - slot_div)) and level.present() then
        objectused = objectused - 1
        if objectused == 0 then
            db.actor:restore_weapon()
            objectinuse = 0
            holster_time = nil
        end
    end
end

-- --- Звуки подбора ---
local function get_sound(path)
    if not snd_cache[path] then snd_cache[path] = xr_sound.get_safe_sound_object(path) end
    return snd_cache[path]
end

local function play_sound(path)
    local snd = get_sound(path)
    if snd then snd:play_at_pos(db.actor, SND_POS, 0.1, sound_object.s2d) end
end

function item_take(obj)
    if not obj then return end
    local section = obj:section()
    local clsid_val = obj:clsid()
    if section == "vodka" then play_sound([[item\bottle]])
    elseif section == "money_maker_1" or section == "money_maker_2" or section == "agr_yan_document" then play_sound([[item\document]])
    elseif clsid_val == clsid.wpn_ammo then play_sound([[item\cartridges]])
    elseif clsid_val == clsid.equ_stalker_s or clsid_val == clsid.equ_exo then play_sound([[item\outfit]])
    elseif section then play_sound([[interface\inv_ruck]]) end
end

-- --- Таблетки ---
function pills(obj)
    if not obj then return end
    local section = obj:section()
    local next_section = painkiller_chain[section]
    if not next_section then return end
    local actor = db.actor
    alife():create(next_section, actor:position(), actor:level_vertex_id(), actor:game_vertex_id(), actor:id())
end

-- ============================================================
-- Визуальный выброс: случайно между 3 и 10 днями,
-- в случайное время суток (час и минута)
-- Длительность: 4 минуты реального времени
-- ============================================================

-- --- Абсолютный день ---
local function get_abs_day()
    if not db.actor then return level.get_time_days() end
    local id = db.actor:id()
    if not db.storage[id] then db.storage[id] = {} end
    if not db.storage[id].pstor then db.storage[id].pstor = {} end
    local pstor = db.storage[id].pstor
    local cur_month_day = level.get_time_days()
    if not pstor["abs_day"] then
        pstor["abs_day"] = cur_month_day
        pstor["last_month_day"] = cur_month_day
        return pstor["abs_day"]
    end
    local last = pstor["last_month_day"] or cur_month_day
    if cur_month_day ~= last then
        pstor["abs_day"] = (pstor["abs_day"] or 0) + 1
        pstor["last_month_day"] = cur_month_day
    end
    return pstor["abs_day"]
end

-- --- Хранение цели: абсолютный день + час + минута ---
-- TODO: db.storage[id].pstor не переживает перезагрузку сейва.
-- Если нужна персистентность — сохранять через actor_binder:save/load
-- или xr_logic.pstor_save/pstor_load.
local function save_next_blowout(abs_day, hour, minute)
    if not db.actor then return end
    local id = db.actor:id()
    if not db.storage[id] then db.storage[id] = {} end
    if not db.storage[id].pstor then db.storage[id].pstor = {} end
    local pstor = db.storage[id].pstor
    pstor["next_blowout_abs"] = abs_day
    pstor["next_blowout_hour"] = hour
    pstor["next_blowout_minute"] = minute
end

local function load_next_blowout()
    if not db.actor then return nil end
    local id = db.actor:id()
    local s = db.storage[id]
    if not s or not s.pstor then return nil end
    local pstor = s.pstor
    if not pstor["next_blowout_abs"] then return nil end
    return {
        abs = pstor["next_blowout_abs"],
        hour = pstor["next_blowout_hour"] or 0,
        minute = pstor["next_blowout_minute"] or 0,
    }
end

-- --- Планирование следующего выброса (день + случайное время) ---
local function schedule_next_blowout(from_abs)
    local delay = math.random(BLOWOUT_MIN_DAYS, BLOWOUT_MAX_DAYS)
    local next_abs = from_abs + delay
    local hour = math.random(0, 23)
    local minute = math.random(0, 59)
    save_next_blowout(next_abs, hour, minute)
    return next_abs, hour, minute
end

-- --- Запуск выброса ---
local function start_visual_blowout()
    level.set_weather_fx("surge_day")

    local snd = xr_sound.get_safe_sound_object([[ambient\earthquake]])
    if snd then
        snd:play_no_feedback(db.actor, sound_object.s2d, 0, vector(), 1.0)
    end

    level.add_cam_effector("camera_effects\\earthquake.anm", 2002, true, "")
    level.add_pp_effector("vibros.ppe", 2001, true)

    db.actor:give_game_news(
        "%c[255,255,80,80]ВНИМАНИЕ! ВЫБРОС!",
        "ui\\ui_iconsTotal",
        Frect():set(0, 0, 83, 47),
        0, 5000
    )

    -- Планируем следующий выброс
    schedule_next_blowout(get_abs_day())

    -- Таймер на 4 минуты
    local start_time = time_global()
    local function delay()
        return (time_global() - start_time) >= BLOWOUT_END_MS
    end
    local function end_blowout()
        level.remove_cam_effector(2002)
        level.remove_pp_effector(2001)
        level.set_weather("default", true)
        level.remove_call(delay, end_blowout)
    end
    level.add_call(delay, end_blowout)
end

-- --- Проверка: день наступил и время пришло ---
function blowout_check()
    local abs_day = get_abs_day()
    local target = load_next_blowout()

    if target == nil then
        -- Новая игра — планируем
        schedule_next_blowout(abs_day)
        return
    end

    -- Если цель «уехала» далеко в прошлое — пересчитываем
    if target.abs < abs_day - 5 then
        schedule_next_blowout(abs_day)
        return
    end

    -- Если день ещё не наступил — ждём
    if abs_day < target.abs then return end

    -- День наступил. Проверяем время суток
    local now_hours = level.get_time_hours()
    local now_minutes = level.get_time_minutes()
    local now_mins = now_hours * 60 + now_minutes
    local target_mins = target.hour * 60 + target.minute

    if now_mins >= target_mins then
        start_visual_blowout()
    end
end

-- ============================================================
-- Указание награды за выполнение задания
-- ============================================================

function add_reward_display(phr)
    if not phr then return end
    local phrase_script = phr:GetPhraseScript()
    if not phrase_script then return end
    -- ВАЖНО: обращаемся к функции через глобальную таблицу скрипта sz_mod,
    -- а не через несуществующую show_reward.
    phrase_script:AddAction("sz_mod.preview_reward")
end

function preview_reward(actor, npc, p1, p2)
    -- task_manager может быть ещё не загружен — страховка
    if not task_manager or not task_manager.CRandomTask then return end

    if random_task == nil then
        random_task = task_manager.CRandomTask()
    end
    if not random_task or not random_task.task_info then return end

    -- В OGSR всегда используем строковый ключ
    local task_id = tostring(p2 - 1)
    local init_phrase_id = random_task.task_id_by_init_phrase_id
        and random_task.task_id_by_init_phrase_id[task_id]
    if not init_phrase_id then return end

    local task_details = random_task.task_info[init_phrase_id]
    if not task_details then return end

    -- Показываем предметы
    local reward_text = format_reward_text(task_details.reward_item)
    if reward_text ~= "" then
        local tex, rect = get_texture_info("ui_iconsTotal_found_thing")
        db.actor:give_talk_message("Награда: " .. reward_text, tex, rect, "iconed_trade_info")
    end

    -- Показываем деньги
    local reward_money = task_details.reward_money
    if reward_money and reward_money > 0 then
        local tex, rect = get_texture_info("ui_iconsTotal_found_money")
        local text = reward_money .. " RU"
        if task_details.need_return and reward_text == "" then
            text = text .. " (" .. game.translate_string("return_for_reward") .. ")"
        end
        db.actor:give_talk_message(text, tex, rect, "iconed_trade_info")
    end
end

function format_reward_text(reward_list)
    if not reward_list then return "" end
    local counts = {}
    for _, v in pairs(reward_list) do
        counts[v] = (counts[v] or 0) + 1
    end
    local parts = {}
    for sec, cnt in pairs(counts) do
        local name = game.translate_string(news_manager.get_inv_name(sec))
        if cnt > 1 then
            table.insert(parts, cnt .. "x " .. name)
        else
            table.insert(parts, name)
        end
    end
    return table.concat(parts, ", ")
end

-- ============================================================
-- Оповещение о повышении ранга
-- ============================================================

-- Порядок рангов от низшего к высшему
local RANK_ORDER = { "novice", "beginner", "experienced", "veteran", "master" }

-- Русские названия для новости
local RANK_NAMES = {
    ["novice"]      = "Новичок",
    ["beginner"]    = "Бывалый",
    ["experienced"] = "Опытный",
    ["veteran"]     = "Ветеран",
    ["master"]      = "Мастер",
}

-- Индекс ранга в RANK_ORDER (0 = novice, 4 = master)
local function rank_index(rank_name)
    for i, name in ipairs(RANK_ORDER) do
        if name == rank_name then return i end
    end
    return 0
end

-- Последний известный ранг (кэш)
local last_rank_name = nil

-- Вызывать из actor_binder:update() (или из on_rank_update, если он есть)
function rank_up()
    local actor = db.actor
    if not actor or not actor:alive() then return end

    local current = ranks.get_obj_rank_name(actor)
    if not current then return end

    -- Первый вызов — запоминаем и выходим (не показываем новость)
    if last_rank_name == nil then
        last_rank_name = current
        return
    end

    -- Ранг не изменился
    if current == last_rank_name then return end

    -- Проверяем, что это именно ПОВЫШЕНИЕ (а не понижение)
    local old_idx = rank_index(last_rank_name)
    local new_idx = rank_index(current)
    last_rank_name = current

    if new_idx <= old_idx then return end  -- понижение — не оповещаем

    -- Показываем новость
    local rank_text = RANK_NAMES[current] or current
    local news_text = "%c[124,247,136,1]Сообщение: \\n%c[default]Ранг повышен: " .. rank_text
    db.actor:give_game_news(
        news_text,
        "ui\\ui_iconsTotal",
        Frect():set(0, 517, 83, 47),
        1000,
        5000
    )
    rank_up_sound()
end

function rank_up_sound()
    local snd_obj = xr_sound.get_safe_sound_object([[device\pda\pda_tip]])
    if snd_obj then
        snd_obj:play_no_feedback(db.actor, sound_object.s2d, 1, vector(), 1.0)
    end
end

-- ============================================================
-- Оповещения о репутации (отдельно от ранга)
-- ============================================================

function news_sound()
    local snd_obj = xr_sound.get_safe_sound_object([[device\pda\pda_sos]])
    snd_obj:play_no_feedback(db.actor, sound_object.s2d, 1, vector(), 1.0)
end

-- --- Смерть сталкеров ---
function kill_npc(victim, who)
    if victim and IsStalker(victim) then
        action(victim, particle("hit_fx\\group_items\\blood_pool","bip01_r_thigh"))
    end
end

-- --- Сон ---
function sleep(obj)
    if obj ~= nil and obj:section() == "sleep_bag" then
        local hud = sleep_ui(get_hud())
        level.start_stop_menu(hud, true)
    end
end

class "sleep_ui" (CUIScriptWnd)

function sleep_ui:__init(owner) super()
    self.owner = owner
    self:InitControls()
    self:InitCallBacks()
end

function sleep_ui:__finalize() end

function sleep_ui:InitControls()
    self:Init(50,50,550,450)
    local xml = CScriptXmlInit()
    xml:ParseFile("ui_sleep.xml")
    xml:InitStatic("back_video", self)
    xml:InitStatic("background", self)
    self:Register(xml:Init3tButton("caption", self),"caption")
    self:Register(xml:Init3tButton("btn_1", self),"btn_1")
    self:Register(xml:Init3tButton("btn_2", self),"btn_2")
    self:Register(xml:Init3tButton("btn_3", self),"btn_3")
    if db.actor.health < 0.9 then self:Register(xml:Init3tButton("btn_4", self),"btn_4") end
    self:Register(xml:Init3tButton("btn_quit", self),"btn_quit")
end

function sleep_ui:InitCallBacks()
    self:AddCallback("btn_1", ui_events.BUTTON_CLICKED, self.sleep_ui1, self)
    self:AddCallback("btn_2", ui_events.BUTTON_CLICKED, self.sleep_ui2, self)
    self:AddCallback("btn_3", ui_events.BUTTON_CLICKED, self.sleep_ui3, self)
    if db.actor.health < 0.9 then self:AddCallback("btn_4", ui_events.BUTTON_CLICKED, self.sleep_ui4, self) end
    self:AddCallback("btn_quit", ui_events.BUTTON_CLICKED, self.on_quit, self)
end

function sleep_ui:OnKeyboard(dik, keyboard_action)
    CUIScriptWnd.OnKeyboard(self,dik,keyboard_action)
    if keyboard_action == ui_events.WINDOW_KEY_PRESSED then
        if dik == DIK_keys.DIK_ESCAPE then self:on_quit() end
        if dik == DIK_keys.DIK_NUMPAD1 then self:sleep_ui1() end
        if dik == DIK_keys.DIK_NUMPAD2 then self:sleep_ui2() end
        if dik == DIK_keys.DIK_NUMPAD3 then self:sleep_ui3() end
        if dik == DIK_keys.DIK_NUMPAD4 then self:sleep_ui4() end
    end
    return true
end

function sleep_ui:sleep_ui1() sleep_one_hour(); self:on_quit() end
function sleep_ui:sleep_ui2() sleep_three_hours(); self:on_quit() end
function sleep_ui:sleep_ui3() sleep_nine_hours(); self:on_quit() end
function sleep_ui:sleep_ui4() sleep_health(scale); self:on_quit() end

function sleep_ui:check_game()
    return level.present() and (db.actor ~= nil) and db.actor:alive()
end

function sleep_ui:on_quit()
    self:GetHolder():start_stop_menu(self, true)
    alife():create("sleep_bag", db.actor:position(), db.actor:level_vertex_id(), db.actor:game_vertex_id(), db.actor:id())
end

function sleep_one_hour() main(1) end
function sleep_three_hours() main(3) end
function sleep_nine_hours() main(9) end
function sleep_health(scale) main((1 - db.actor.health)*5.00) end

function main(scale)
    basic_time_factor = level.get_time_factor ()
    db.actor:stop_talk()
    starter (scale)
    level.disable_input()
end

function starter(scale)
    local factor = scale * 2930
    game.start_tutorial("time_scaling")
    level.set_time_factor(factor)
end

function dreamer()
    level.set_time_factor(basic_time_factor)
    local dream = dream.sleep_video_name_callback ()
    if dream ~= "" then game.start_tutorial(dream) else game.start_tutorial("without_dream") end
end

function stopper()
    alarm_sound()
    level.add_cam_effector("camera_effects\\prison_1.anm", 1, false, "")
    level.add_pp_effector("yantar_underground_psi.ppe", 222, false, "")
    db.actor:hide_weapon()
    set_inactivate_input_time(30)
    db.actor:restore_weapon()
end

function alarm_sound()
    local snd_obj = xr_sound.get_safe_sound_object([[device\pda\pda_alarm]])
    snd_obj:play_no_feedback(db.actor, sound_object.s2d, 0, vector(), 1.0)
end

-- --- Спавн итема ---
function spawn_item(spawn_item, dist)
    local a = vector(); a.y = 1
    local pos = db.actor:position():add(a)
    local dir = db.actor:direction()
    pos = pos:add(dir:mul(dist))
    alife():create(spawn_item, pos, 1, db.actor:game_vertex_id())
end

-- --- Регенерация от брони ---
class "fix_armor"

function fix_armor:__init()
    self.update_time = time_global()
    self.delta_time = 1000
end

function fix_armor:update()
    if self.update_time < time_global() then
        self:update_outfit_section()
        self.update_time = time_global() + self.delta_time
    end
end

function fix_armor:update_outfit_section()
    local item = db.actor:item_in_slot(6)
    if not item then return end
    local section = item:section()
    if section == "outfit_novice_m1" then
        db.actor.health = math.min(db.actor.health + 0.0006, 1.0)
        db.actor.power  = math.min(db.actor.power  + 0.003,  1.0)
    elseif section == "outfit_stalker_m1" then
        db.actor.health = math.min(db.actor.health + 0.0006, 1.0)
    elseif section == "outfit_killer_m2" then
        db.actor.power  = math.min(db.actor.power  + 0.001,  1.0)
    end
end