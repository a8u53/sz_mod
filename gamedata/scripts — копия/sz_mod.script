    ["medkit"]          = {sound = [[actor\inv_medkit]],   holster = 2000, spawn = "medkit_e"},
    ["medkit_army"]     = {sound = [[actor\inv_medkit]],   holster = 2000, spawn = "medkit_e"},
    ["medkit_scientic"] = {sound = [[actor\inv_medkit]],   holster = 2000, spawn = "medkit_e"},
    ["antirad"]         = {sound = [[actor\inv_pills]],    holster = 1000, spawn = "tabletki_e"},
    ["antirad_pills"]   = {sound = [[actor\inv_pills]],    holster = 1000, spawn = "tabletki_e"},
    ["painkiller_1"]    = {sound = [[actor\inv_pills]],    holster = 1000, spawn = "tabletki_e"},
    ["bandage"]         = {sound = [[actor\inv_bandage]],  holster = 2000},
    ["painkiller_4"]    = {sound = [[actor\inv_pills]],    holster = 1000},
    ["painkiller_3"]    = {sound = [[actor\inv_pills]],    holster = 1000},
    ["painkiller_2"]    = {sound = [[actor\inv_pills]],    holster = 1000},
    ["vodka"]           = {sound = [[actor\drink_1]],      holster = 2000, spawn = "vodka_a", psy = 0.1},
    ["af_rog"]          = {sound = [[anomaly\anomaly_gravy_blast]], holster = 2000, spawn_eatble = true, spawn_self = "af_rog"},
    ["energy_drink"]    = {sound = [[actor\inv_softdrink]], holster = 2000, spawn = "energy_drink_e"},
    ["voda"]            = {sound = [[actor\inv_softdrink]], holster = 2000, spawn = "energy_drink_e"},
