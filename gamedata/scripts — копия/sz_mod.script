-- --- Броня ---
local armor_last_static = nil

-- --- Радиация ---
local rad_update_time = 0
local DETECTOR_SECTION = "detector_simple"
local BACK_X = 50
local BACK_Y = 50
local BACK_W = 20
local BACK_H = 200

-- --- Лут денег ---
local looted_money = {}
local no_money_chance = 0.25

-- --- Время на экране ---
local last_time_update = 0
local time_update_interval = 1000

-- --- Еда / расходники ---
local cards = {"card_1", "card_2", "card_3", "card_4", "card_5", "card_6", "card_7", "card_8", "card_9", "card_10"}
local eatbles = {"bread_sub", "conserva_sub", "kolbasa_sub"}
local SPAWN_OFFSET = 0.3

objectinuse = 0
objectused = 0

