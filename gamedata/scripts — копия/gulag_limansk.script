-- Job -------------------------------------------------------------------
local t = {}

function load_job(sj, gname, type, squad, groups)

	if type == "lim_mon_construction_smart" then
		t = { section = "logic@lim_mon_construction_smart",
			idle = 0,
			prior = 1, state = {0},
			in_rest = "", out_rest = "lim_monolit_stroyka_rest"
		}
       table.insert(sj, t)	
        t = { section = "logic@lim_mon_construction_smart",
