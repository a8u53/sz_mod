function load_states(gname, type)

	if type == "lim_mon_construction_smart" then
		return function(gulag)
			return 0
		end
	end
	
	if type == "lim_mon_prip_road" then
		return function(gulag)
			return 0
		end
	end	

end

--------------------------------------------------------------------------
-- Dynamic ltx
--------------------------------------------------------------------------
function load_ltx(gname, type)
	return nil
end

function checkStalker(npc_community, gulag_type)

	if gulag_type == "lim_mon_construction_smart" or	
	   gulag_type == "lim_mon_prip_road" then
	   return npc_community == "monolith"
	end
		
	return false
end

function checkMonster(npc_community, gulag_type)
	if gulag_type == "bb" then
			return npc_community == "boar"
	end
	if gulag_type == "bba" then
			return npc_community == "boar"
	end
	if gulag_type == "bbs" then
			return npc_community == "boar"
	end
	return false
	
end