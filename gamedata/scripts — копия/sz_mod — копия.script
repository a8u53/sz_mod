function soundhub()
	if db.actor:alive() then
	sound_obj_left:play_at_pos ( db.actor, vector():set(-1, 0, 0), 0, sound_object.s2d)
	sound_obj_right:play_at_pos ( db.actor, vector():set( 1, 0, 0), 0, sound_object.s2d)	
	sound_obj_left = sound_object([[$no_sound]])
	sound_obj_right = sound_object([[$no_sound]])

		if (objectinuse==0) then
		db.actor:hide_weapon()
		objectinuse=1
			if slotinuse == 1 then
			slot_div = ((holster_time-time_global())/1.5)
			else
			slot_div = 0
			end
		end
	objectused=objectused+1
	weapontimer()
	end
end

function weapontimer()
	if (holster_time~=nil) and (time_global()>(holster_time-slot_div)) and level.present() then
	objectused=objectused-1
		if (objectused==0) then
		db.actor:restore_weapon()
		objectinuse=0
		holster_time=nil
		end
	end
end

--Звук подбора предметов

function item_take(obj)
	if obj:section() == "vodka" then
	snd_obj = xr_sound.get_safe_sound_object([[item\bottle]])
	snd_obj:play_at_pos(db.actor,vector():set(0,0,0),0.1,sound_object.s2d)

	elseif obj:section() == "money_maker_1" or obj:section() == "money_maker_2" or obj:section() == "agr_yan_document" then
		snd_obj = xr_sound.get_safe_sound_object([[item\document]])
	snd_obj:play_at_pos(db.actor,vector():set(0,0,0),0.1,sound_object.s2d)
	
	elseif obj:clsid() == clsid.wpn_ammo then
		snd_obj = xr_sound.get_safe_sound_object([[item\cartridges]])
	snd_obj:play_at_pos(db.actor,vector():set(0,0,0),0.1,sound_object.s2d)
	
	elseif obj:clsid() == clsid.equ_stalker_s or obj:clsid() == clsid.equ_exo then
		snd_obj = xr_sound.get_safe_sound_object([[item\outfit]])
	snd_obj:play_at_pos(db.actor,vector():set(0,0,0),0.1,sound_object.s2d)
	
	elseif obj:section() then
		snd_obj = xr_sound.get_safe_sound_object([[interface\inv_ruck]])
	snd_obj:play_at_pos(db.actor,vector():set(0,0,0),0.1,sound_object.s2d)	
	end
end

--Коллекционные карточки
function cigarettes_pack(obj)
	if obj:section() == "painkiller_4" then
		alife():create("painkiller_3",db.actor:position(), db.actor:level_vertex_id(), db.actor:game_vertex_id(), db.actor:id())
	elseif obj:section() == "painkiller_3" then
		alife():create("painkiller_2",db.actor:position(), db.actor:level_vertex_id(), db.actor:game_vertex_id(), db.actor:id())
	elseif obj:section() == "painkiller_2" then
		alife():create("painkiller_1",db.actor:position(), db.actor:level_vertex_id(), db.actor:game_vertex_id(), db.actor:id())
	end
end

--Выброс
class "blowout"
function blowout:__init()
	self.update_time = time_global()
	self.delta_time = 120000
end

function blowout:update()
	if self.update_time < time_global() then
		if self:update_time_blowout() then
		end
		self.update_time = time_global() + self.delta_time
	end
end

function blowout:update_time_blowout()
    -- включаем предварительный эффект выброса
    xr_effects.start_small_reject (actor, npc)
 
    -- сделаем чтобы для урона была вероятность
    if math.random(0, 1001) < 999 then
 
    -- создаем урон
    local h = hit()
    h.direction = vector():set( 1, 0, 0 ) 
    h.impulse = 1 
    h.draftsman = db.actor 
    h.power = 0.1 
    h.type = hit.telepatic
    db.actor:hit(h)
	end
end

--Фикс доп. характеристик брони (частичный)
class "fix_armor"

function fix_armor:__init()
--	dbglog("fix_armor:_init()")
	self.update_time = time_global()
	self.delta_time = 1000
end

function fix_armor:update()
	if self.update_time < time_global() then
		if self:update_outfit_section() then
		end
		self.update_time = time_global() + self.delta_time
	end
end

function fix_armor:update_outfit_section()
	local item = db.actor:item_in_slot(6)
	if item and item:section() == "outfit_novice_m1" then
		db.actor.health = tonumber(0.0006) * 1
		db.actor.power = tonumber(0.003) * 1
	elseif item and item:section() == "outfit_stalker_m1" then
		db.actor.health = tonumber(0.0006) * 1
	elseif item and item:section() == "outfit_killer_m2" then
		db.actor.power = tonumber(0.001) * 1
	end
end