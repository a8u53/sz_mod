--Оповещение о повышении ранга
function rank_up()
	if (db.actor:character_rank() >= 150) and not (db.actor:character_rank() >= 300) then db.actor:give_info_portion("got_it")
		elseif (db.actor:character_rank() >= 300) and not (db.actor:character_rank() >= 600) then db.actor:give_info_portion("got_it_2")
		elseif (db.actor:character_rank() >= 600) and not (db.actor:character_rank() >= 900) then db.actor:give_info_portion("got_it_3")
		elseif (db.actor:character_rank() >= 900) and not (db.actor:character_rank() >= 300) then db.actor:give_info_portion("got_it_4")
		elseif relation_registry.community_goodwill ("stalker") < -450 then db.actor:give_info_portion("bandit_way")
		elseif relation_registry.community_goodwill ("freedom") < -500 then db.actor:give_info_portion("freedom_enemy")
		elseif relation_registry.community_goodwill ("dolg") < -500 then db.actor:give_info_portion("dolg_enemy")
	end
end

