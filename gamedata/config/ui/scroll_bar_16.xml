			<texture_e>ui\lw_blank</texture_e>
			<texture_h>ui\lw_blank</texture_h>
			<texture_t>ui\lw_blank</texture_t>
		</up_arrow>
		<down_arrow width="17" height="30">
			<texture_e>ui\lw_blank</texture_e>
			<texture_h>ui\lw_blank</texture_h>
			<texture_t>ui\lw_blank</texture_t>
		</down_arrow>
		
		<left_arrow width="21" height="17">
			<texture_e>ui\lw_blank</texture_e>
			<texture_h>ui\lw_blank</texture_h>
			<texture_t>ui\lw_blank</texture_t>
		</left_arrow>
		<right_arrow width="21" height="17">
			<texture_e>ui\lw_blank</texture_e>
			<texture_h>ui\lw_blank</texture_h>
			<texture_t>ui\lw_blank</texture_t>
		</right_arrow>
		
		<back width="21" height="17">
			<texture>ui\lw_blank</texture>
		</back>		
		<back_v width="21" height="17">
			<texture>ui\lw_blank</texture>
		</back_v>
		
		<box>
			<texture>ui\lw_blank</texture>
		</box>
		<box_v> <!--width="17" height="30"-->
			<texture>ui\lw_blank</texture>
		</box_v>	
