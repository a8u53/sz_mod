<?xml version="1.0" encoding="utf-8"?>

<scroll_bar>
	<default height="15" height_v="15" hold_delay="40">
		<left_arrow width="10" height="16">
			<texture_e>ui\ui_scb_left_arrow</texture_e>
		</left_arrow>
		<right_arrow width="10" height="16">
			<texture_e>ui\ui_scb_right_arrow</texture_e>
		</right_arrow>
		<back width="10" height="13">
			<texture>ui\ui_scb_back</texture>
		</back>
		<box frame_mode="0" vertical="1">
			<texture>ui\ui_scb_scroll_box</texture>
		</box>
		
		
		<up_arrow width="15" height="16">
			<_texture_e>ui\ui_scb_up_arrow</_texture_e>
			<texture_e>ui_scroll_btn_up</texture_e>
		</up_arrow>
		<down_arrow width="15" height="16">
			<_texture_e>ui\ui_scb_down_arrow</_texture_e>
			<texture_e>ui_scroll_btn_down</texture_e>
		</down_arrow>		
		<back_v width="15" height="13">
			<_texture>ui\ui_scb_back_v</_texture>
			<texture>ui_scroll_back</texture>
		</back_v>		
		<box_v frame_mode="0" vertical="1">
			<_texture>ui\ui_scb_scroll_box_v</_texture>
			<texture>ui_scroll_box</texture>
		</box_v>		
	</default>

	<box_list height="10" height_v="15" hold_delay="40">
		<left_arrow width="15" height="16">
			<texture_e>ui\ui_scb_left_arrow</texture_e>
		</left_arrow>
		<right_arrow width="15" height="16">
			<texture_e>ui\ui_scb_right_arrow</texture_e>
		</right_arrow>
		<back width="15" height="13">
			<texture>ui\ui_scb_back</texture>
		</back>
		<box frame_mode="0" vertical="1">
			<texture>ui\ui_scb_scroll_box</texture>
		</box>
		
		
		<up_arrow width="15" height="16">
			<_texture_e>ui\ui_scb_up_arrow</_texture_e>
			<texture_e>ui_scroll_btn_up</texture_e>
		</up_arrow>
		<down_arrow width="15" height="16">
			<_texture_e>ui\ui_scb_down_arrow</_texture_e>
			<texture_e>ui_scroll_btn_down</texture_e>
		</down_arrow>		
		<back_v width="15" height="13">
			<_texture>ui\ui_scb_back_v</_texture>
			<texture>ui_scroll_back</texture>
		</back_v>		
		<box_v frame_mode="0" vertical="1">
			<_texture>ui\ui_scb_scroll_box_v</_texture>
			<texture>ui_scroll_box</texture>
		</box_v>		
	</box_list>
	
	<pda height="17">
