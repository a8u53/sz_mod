[logic]
active = ph_door@open

; Open between rounds. The actor's entry into the pre-room closes it.
[ph_door@open]
locked = false
closed = true
on_use = ph_door@unlocked
snd_open_start = trader_door_open_start
snd_close_start = trader_door_close_start
snd_close_stop = trader_door_close_stop
on_info = {+bar_arena_pre_room_entered} ph_door@closed

; Keep the entrance locked during the mutant fight.
[ph_door@closed]
locked = true
closed = true
close_velocity = 16
snd_open_start = trader_door_open_start
snd_close_start = trader_door_close_start
snd_close_stop = trader_door_close_stop
on_info = {+bar_arena_monstr_dead} ph_door@open_after_fight

; Wait until the zone has cleared pre_room_entered before returning to the normal open state.
; This avoids immediately re-closing the door on the same stale entry flag.
[ph_door@open_after_fight]
locked = false
closed = true
on_use = ph_door@open
snd_open_start = trader_door_open_start
snd_close_start = trader_door_close_start
snd_close_stop = trader_door_close_stop
on_info = {-bar_arena_pre_room_entered} ph_door@open

[ph_door@unlocked]
locked = false
closed = false
on_use = ph_door@open
on_info = {+bar_arena_pre_room_entered} ph_door@closed
snd_open_start = trader_door_open_start
snd_close_start = trader_door_close_start
snd_close_stop = trader_door_close_stop