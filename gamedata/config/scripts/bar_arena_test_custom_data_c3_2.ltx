[smart_terrains]
none = true

[spawner]
cond = {+bar_arena_test_active}

[logic]
active = walker
on_death = death@arena_test
combat_ignore = combat_ignore

[combat_ignore]

[walker]
path_walk = bar_arena_wait_walk_4
path_look = bar_arena_wait_look
combat_ignore_cond = always
on_info = {+bar_arena_test_fight_begin} walker@1

[walker@1]
path_walk = bar_arena_walk_1_1
def_state_moving1 = raid
def_state_moving2 = raid
def_state_moving3 = raid
wounded = wounded@ignore

[wounded@ignore]
hp_state        = 0|wounded_heavy@help_heavy
hp_state_see    = 0|wounded_heavy@help_heavy
hp_victim       = 0|nil
hp_fight        = 0|false
hp_cover        = 0|false

[death@arena_test]
on_info = %=arena_test_finish%