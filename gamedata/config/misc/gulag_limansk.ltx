;-------------------------------------------------------------------------------------------------
;Monolith
;-------------------------------------------------------------------------------------------------
;Строители
;Костры

[logic@lim_mon_construction_smart]
active = kamp@lim_mon_construction_smart

[kamp@lim_mon_construction_smart]
center_point = kamp
path_walk    = kamp_task
soundgroup 	 = mon_1

;Патрули

[logic@lim_mon_construction_smart_patrol]
active = walker@lim_mon_construction_smart_patrol

[walker@lim_mon_construction_smart_patrol]
path_walk = patrol_walk

[logic@lim_mon_construction_smart_patrol_2]
active = walker@lim_mon_construction_smart_patrol_2

[walker@lim_mon_construction_smart_patrol_2]
path_walk = patrol_2_walk

[logic@lim_mon_construction_smart_patrol_3]
active = walker@lim_mon_construction_smart_patrol_3

[walker@lim_mon_construction_smart_patrol_3]
path_walk = patrol_3_walk

[logic@lim_mon_construction_smart_patrol_4]
active = walker@lim_mon_construction_smart_patrol_4

[walker@lim_mon_construction_smart_patrol_4]
path_walk = patrol_4_walk

[logic@lim_mon_construction_smart_patrol_5]
active = walker@lim_mon_construction_smart_patrol_5

[walker@lim_mon_construction_smart_patrol_5]
path_walk = patrol_5_walk

;Снайперы

[logic@lim_mon_construction_smart_sniper]
active = camper@lim_mon_construction_smart_sniper

[camper@lim_mon_construction_smart_sniper]
path_walk = sniper_walk
path_look = sniper_look
sniper = true
def_state_campering = threat

[logic@lim_mon_construction_smart_sniper_2]
active = camper@lim_mon_construction_smart_sniper_2

[camper@lim_mon_construction_smart_sniper_2]
path_walk = sniper_2_walk
path_look = sniper_2_look
sniper = true
def_state_campering = threat

;Смотрюны

[logic@lim_mon_construction_camper]
active = camper@lim_mon_construction_camper

[camper@lim_mon_construction_camper]
path_walk = camper_walk
path_look = camper_look
def_state_campering = threat

;Плавуны
;Патруль дороги

[logic@lim_mon_prip_road]
active = patrol@lim_mon_prip_road

[patrol@lim_mon_prip_road]
path_walk = patrol_walk
path_look = patrol_look
formation = back
commander = true


[logic@lim_mon_prip_road_follower1]
active = patrol@lim_mon_prip_road_follower1

[patrol@lim_mon_prip_road_follower1]
path_walk = patrol_walk
path_look = patrol_look
formation = back
commander = false


[logic@lim_mon_prip_road_follower2]
active = patrol@lim_mon_prip_road_follower2

[patrol@lim_mon_prip_road_follower2]
path_walk = patrol_walk
path_look = patrol_look
formation = back
commander = false

;Террорист
[logic@lim_mon_prip_road_rpg]
active = camper@lim_mon_prip_road_rpg

[camper@lim_mon_prip_road_rpg]
path_walk = rpg_walk
path_look = rpg_look
def_state_campering = threat

;Снайпер

[logic@lim_mon_prip_road_sniper]
active = camper@lim_mon_prip_road_sniper

[camper@lim_mon_prip_road_sniper]
path_walk = sniper_walk
path_look = sniper_look
sniper = true
def_state_campering = threat

;Бродюны

[logic@lim_mon_prip_base]
active = walker@lim_mon_prip_base

[walker@lim_mon_prip_base]
path_walk = base_walk


[logic@lim_mon_prip_base_2]
active = walker@lim_mon_prip_base_2

[walker@lim_mon_prip_base_2]
path_walk = patrol_2_walk