/**
 * OGSR Engine R4 - Blood wallmark bump shading
 *
 * Screen-space embossed shading derived from the existing decal alpha.
 * This shader is used only by effects_wallmark_blood.s.
 */

#include "common.h"

uniform float4 ssfx_blood_decals;

float4 main(p_TL I) : SV_Target
{
    float4 res = s_base.Sample(smp_base, I.Tex0);

    // Keep the original blood decal color and opacity adjustments.
    res.rgb *= ssfx_blood_decals.x;
    res.a = saturate(res.a * 1.7f - 0.7f) * ssfx_blood_decals.y;
    res.a *= 1.0f - I.Color.a;

    // Treat the decal alpha as a shallow height field. Derivatives provide
    // the local slope without requiring an additional texture or G-buffer.
    float height = saturate(res.a);
    float2 slope = float2(ddx(height), ddy(height));
    float3 bumpNormal = normalize(float3(-slope * 18.0f, 1.0f));

    // Fixed screen-space light direction creates a subtle raised/recessed
    // appearance while preserving the original decal transparency.
    float3 lightDir = normalize(float3(-0.35f, -0.45f, 0.82f));
    float lighting = saturate(dot(bumpNormal, lightDir));
    float relief = lerp(0.72f, 1.18f, lighting);

    // Fade the relief with the decal itself so transparent pixels stay clean.
    res.rgb *= lerp(1.0f, relief, height);

    return float4(res.rgb, res.a);
}
