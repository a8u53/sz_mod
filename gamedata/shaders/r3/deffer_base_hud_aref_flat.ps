#include "common.h"
#include "sload.h"
#include "screenspace_hud_raindrops.h"
#include "screenspace_hud_blood_model.h"

f_deffer main(p_flat I)
{
    f_deffer O;

    // 1. Base texture + kill pixels with low alpha

    float4 D = tbase(I.tcdh);

    calc_alpha_test(I.tcdh.xy, D.a);

    float blood_load = max(ssfx_hud_blood_params.x, ssfx_hud_blood_params.y);
    float3 blood_bump_model = 0.0f;
    float blood_gloss = 0.0f;
    float4 blood = ssfx_hud_blood_model_space(
        s_hud_rain, I.RDrops.xyz, I.position.xyz,
        blood_load, ssfx_hud_blood_params.w, ssfx_hud_blood_params.z,
        blood_bump_model, blood_gloss);
    D.rgb = lerp(D.rgb, blood.rgb, blood.a);

#ifdef USE_TDETAIL
    // D.rgb = 2*D.rgb*tex2D(s_detail, I.tcdbump).rgb;
    D.rgb = 2 * D.rgb * s_detail.Sample(smp_base, I.tcdbump).rgb;
#endif

    // hemi,sun,material
    float ms = xmaterial;
#ifdef USE_LM_HEMI
    // float4 lm = tex2D(s_hemi, I.lmh);
    float4 lm = s_hemi.Sample(smp_rtlinear, I.lmh);
    // float h = dot(lm.rgb,1.h/3.h);
    float h = get_hemi(lm);
#ifdef USE_R2_STATIC_SUN
    // ms = lm.w ;
    ms = get_sun(lm);
#endif
#else
    float h = I.position.w;
#ifdef USE_R2_STATIC_SUN
    ms = I.tcdh.w;
#endif
#endif

    // 2. Standart output
    float2 blood_gradient = float2(ddx(blood.a), ddy(blood.a));
    float3 blood_relief = float3(-blood_gradient * 0.38f, 0.0f);
    float3 blood_bump_eye = mul((float3x3)m_WV, blood_bump_model);
    float4 Ne = float4(normalize((float3)I.N.xyz +
        blood_relief + blood_bump_eye * 0.20f), h);
    float gloss = def_gloss + blood_gloss;
    O = pack_gbuffer(Ne, float4(I.position.xyz + Ne.xyz * def_virtualh / 2.h, ms), float4(D.rgb, gloss));

    O.Velocity = get_motion_vector(I.hpos_curr, I.hpos_old);

    return O;
}
