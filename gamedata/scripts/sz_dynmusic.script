-- sz_dynmusic.script
-- Äèíàìè÷åñêàÿ áîåâàÿ ìóçûêà.
-- Åñëè äëÿ ëîêàöèè íåò òðåêà — èãðàåò ñëó÷àéíûé èç çàïàñíîãî ñïèñêà.

local music_table = {
    ["l01_escape"] = {
        combat = "music\\cordon_combat",
    },
	["l10_radar"] = {
        combat = "music\\radar_combat",
    },
    ["l15_limansk"] = {
        combat = "music\\limansk_combat",
    },
}

-- Çàïàñíûå òðåêè: èãðàþò íà ëîêàöèÿõ, äëÿ êîòîðûõ íåò çàïèñè â music_table
local fallback_tracks = {
    "music\\cordon_combat",
    "music\\radar_combat",
    "music\\limansk_combat",
}

local current_combat = nil
local last_check = 0
local check_interval = 1000
local in_combat_state = false

local combat_timer = 0
local combat_timeout = 10000
local combat_radius = 100

-- Ïëàâíîå çàòóõàíèå
local target_volume = 0
local current_volume = 0
local fade_speed = 0.1

-- Online stalkers and mutants eligible for combat checks.
local tracked_objects = {}

function register_combatant(obj)
    if not obj then return end

    if IsStalker(obj) or IsMonster(obj) then
        tracked_objects[obj:id()] = true
    end
end

function unregister_combatant(obj)
    if not obj then return end

    tracked_objects[obj:id()] = nil
end

local function has_visible_enemy()
    local actor = db.actor
    if not actor then return false end

    local actor_pos = actor:position()
    local actor_id = actor:id()

    for id in pairs(tracked_objects) do
        if id ~= actor_id then
            local obj = level.object_by_id(id)

            if not obj then
                -- The object is no longer online.
                tracked_objects[id] = nil

            elseif obj:alive() and obj:relation(actor) == game_object.enemy then
                local distance = actor_pos:distance_to(obj:position())

                if distance <= combat_radius and obj:see(actor) then
                    return true
                end
            end
        end
    end

    return false
end

local function is_in_combat()
    local now = time_global()

    if has_visible_enemy() then
        combat_timer = now + combat_timeout
        return true
    end

    if now < combat_timer then
        return true
    end

    return false
end

-- Âûáîð òðåêà: ñíà÷àëà ïî ëîêàöèè, èíà÷å — ñëó÷àéíûé èç çàïàñíûõ
local function pick_combat_track()
    local map = level.name()
    local entry = music_table[map]

    if entry and entry.combat then
        return entry.combat
    end

    if #fallback_tracks > 0 then
        return fallback_tracks[math.random(#fallback_tracks)]
    end

    return nil
end

local function switch_to_combat()
    if not current_combat then
        local track = pick_combat_track()
        if not track then return end

        current_combat = sound_object(track)
        if current_combat then
            current_combat:play(db.actor, 0, sound_object.s2d + sound_object.looped)
            pcall(function() current_combat.volume = 0 end)
            target_volume = 1
            current_volume = 0
        end
    else
        target_volume = 1
    end
end

local function switch_to_ambient()
    target_volume = 0
end

function update()
    if not db.actor or not db.actor:alive() then return end

    local time = time_global()
    if time - last_check < check_interval then return end
    last_check = time

    local now_in_combat = is_in_combat()

    if now_in_combat and not in_combat_state then
        switch_to_combat()
        in_combat_state = true
    elseif not now_in_combat and in_combat_state then
        switch_to_ambient()
        in_combat_state = false
    end

    -- Ïëàâíîå çàòóõàíèå
    if current_combat then
        if current_volume < target_volume then
            current_volume = math.min(current_volume + fade_speed, target_volume)
        elseif current_volume > target_volume then
            current_volume = math.max(current_volume - fade_speed, target_volume)
        end

        pcall(function() current_combat.volume = current_volume end)

        if target_volume == 0 and current_volume == 0 then
            pcall(function() current_combat:stop() end)
            current_combat = nil
        end
    end
end