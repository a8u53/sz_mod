local MIN_WIND, MAX_WIND, WIND_STEP, WIND_UPDATE_MINUTES = 150, 650, 50, 1
-- Новые параметры для порывов
local GUST_CHANCE = 0.15       -- Вероятность порыва (15%)
local GUST_MULTIPLIER = 1.5    -- Во сколько раз усиливается ветер при порыве
local GUST_DURATION = 3        -- Сколько минут длится порыв (в игровых минутах)

local function clamp(n, min, max)
	if min > max then min, max = max, min end
	return (n > max and max) or (n < min and min) or n
end

class "WeatherManager"
function WeatherManager:__init()
	self.weather_change_day = 0
	self.update_time = 0
	self.update_level = ""
	self.lcall = nil
	self.gust_remaining = 0 -- Счётчик оставшихся минут порыва
end

function WeatherManager:reset()
	if not db.actor then return end

	local ini = ini_file("game.ltx")
	local weather = utils.cfg_get_string(ini, level.name(), "weathers", db.actor, false, "", "default")
	local postprocess = utils.cfg_get_string(ini, level.name(), "postprocess", db.actor, false, "")
	
	-- ИСПРАВЛЕНО: проверка на пустую строку
	if postprocess ~= nil and postprocess ~= "" then
		printf("LEVEL POSTPROCESS: level: [%s], postprocess: [%s]", level.name(), postprocess)
		level.add_pp_effector(postprocess, 999, true)
	else
		printf("LEVEL POSTPROCESS: level: [%s], postprocess: [none]", level.name())
		level.remove_pp_effector(999)
	end

	if weather == "default" then
		self.weather_list = xr_logic.parse_condlist(db.actor, level.name(), "weather", "default")
	else
		self.weather_list = xr_logic.parse_condlist(db.actor, level.name(), "weather", weather)
	end

	-- Сбрасываем старый call при смене уровня, чтобы он создался заново
	self.lcall = nil
	self.gust_remaining = 0

	self:select_weather(true)
end

function WeatherManager:select_weather(forced)
	forced = forced or false
	self.weather_change_day = level.get_time_days()
	self.update_level = level.name()

	local weather = xr_logic.pick_section_from_condlist(db.actor, db.actor, self.weather_list)
	if not weather then
		printf("WEATHER: nil from condlist, fallback to 'default'")
		weather = "default"
	end
	printf("WEATHER: '%s' now '%s'", weather, tostring(forced))
	level.set_weather(weather, forced)

	local env = level.environment()
	if env then
		for idx = 0, 1 do
			local env_desc = env:getCurrentWeather(idx)
			if env_desc then
				env_desc.wind_velocity = math.random(MIN_WIND, MAX_WIND)
				env_desc.wind_direction = utils.deg2rad(math.random(360))
				-- Защита от отсутствия поля (если вдруг его нет в сборке)
				if env_desc.m_fSunShaftsIntensity ~= nil then
					env_desc.m_fSunShaftsIntensity = math.random(1500) * 0.0001
				end
			end
		end
	end

	-- ИСПРАВЛЕНО: надёжное создание колбэка с set_pause
	if not self.lcall then
		local call
		call = level.add_call(function()
			local env2 = level.environment()
			if env2 then
				for idx = 0, 1 do
					local env_desc = env2:getCurrentWeather(idx)
					if env_desc then
						-- Логика порывов
						if self.gust_remaining > 0 then
							self.gust_remaining = self.gust_remaining - 1
						elseif math.random() < GUST_CHANCE then
							self.gust_remaining = GUST_DURATION
						end

						local current_max = MAX_WIND
						if self.gust_remaining > 0 then
							current_max = MAX_WIND * GUST_MULTIPLIER
						end

						if env_desc.wind_velocity < MIN_WIND then
							env_desc.wind_velocity = math.random(MIN_WIND, current_max)
						end
						
						-- Плавное изменение ветра
						env_desc.wind_velocity = clamp(env_desc.wind_velocity + math.random(-WIND_STEP, WIND_STEP), MIN_WIND, current_max)
						
						-- Небольшое случайное изменение направления (чтобы ветер "гулял")
						env_desc.wind_direction = env_desc.wind_direction + utils.deg2rad(math.random(-5, 5))
					end
				end
			end
			if call and call.set_pause then
				call:set_pause(WIND_UPDATE_MINUTES * 60 * 1000)
			end
			return false
		end, function() end)
		self.lcall = call
	end
end

function WeatherManager:load(F)
	self.update_level = F:r_stringZ() or ""
	self.update_time = F:r_u32() or 0
end

function WeatherManager:save(F)
	F:w_stringZ(self.update_level or "")
	F:w_u32(self.update_time or 0)
end

function WeatherManager:update()
	if self.update_time <= time_global() then
		printf("weather_update day [%s]", level.get_time_days())

		if self.update_level ~= level.name() then
			self:select_weather(true)
		end

		if self.weather_change_day ~= level.get_time_days() then
			self:select_weather(false)
		end

		-- Исправлено: привязка к текущему time_global
		self.update_time = time_global() + 10000
	end
end