function init    (obj)
	xr_motivator.AddToMotivator(obj)
end

function actor_init    (npc)
	npc:bind_object(actor_binder(npc))
end

local game_difficulty_by_num = {
	[0] = "gd_novice",
	[1] = "gd_stalker",
	[2] = "gd_veteran",
	[3] = "gd_master"
	}

lasthealth  = 0
lasttime	= 0
post_process = 0
local weapon_hide = false

-- Placement-sound helpers. OGSR exposes place_item_to_box, but some inventory-box
-- transfer paths also dispatch take_item_from_box for both directions.
local last_item_transfer_sounds = {}
local ITEM_TRANSFER_SOUND_DEBOUNCE = 500

local function get_item_parent_id(item)
    if not item then return nil end
    local ok, parent = pcall(function() return item:parent() end)
    if not ok or not parent then return nil end
    local id_ok, parent_id = pcall(function() return parent:id() end)
    if id_ok then return parent_id end
    return nil
end

local function is_item_inside_box(box, item)
    if not box or not item then return false end
    local box_ok, box_id = pcall(function() return box:id() end)
    if not box_ok or box_id == nil then return false end
    return get_item_parent_id(item) == box_id
end

local function resolve_box_and_item(first, second)
    -- Support either argument order; the parent relation identifies the moved item.
    if is_item_inside_box(second, first) then
        return second, first
    end
    if is_item_inside_box(first, second) then
        return first, second
    end
    -- The take_item_from_box convention used by this script is (box, item).
    return first, second
end

local function play_item_transfer_sound(item)
    if not item or not sz_mod or not sz_mod.item_take then return end

    local id_ok, item_id = pcall(function() return item:id() end)
    local now = time_global()
    if id_ok and item_id ~= nil then
        local last_time = last_item_transfer_sounds[item_id]
        if last_time and now - last_time < ITEM_TRANSFER_SOUND_DEBOUNCE then
            return
        end
        last_item_transfer_sounds[item_id] = now
    end

    -- Reuse the existing category-aware sounds (bottle, document, cartridges,
    -- outfit and the generic inventory sound) so no new sound assets are needed.
    sz_mod.item_take(item)
end

local function is_inventory_box_object(obj)
    if not obj then return false end
    local ok = pcall(function() return obj:is_inv_box_empty() end)
    return ok
end

local function get_single_transfer_item(first, second)
    if second == nil then return first end

    -- Prefer the item whose parent is the other callback argument.
    if is_item_inside_box(first, second) then return second end
    if is_item_inside_box(second, first) then return first end

    -- If the parent relation is not yet updated, identify the box by its API.
    if is_inventory_box_object(first) then return second end
    if is_inventory_box_object(second) then return first end

    -- on_inv_box_item_drop normally passes the moved item first.
    return first
end
class "actor_binder" (object_binder)
----------------------------------------------------------------------------------------------------------------------
function actor_binder:__init (obj) super(obj)
	self.bCheckStart = false
	self.sz_death_screen_active = false
	self.weather_manager = level_weathers.WeatherManager()
	self.actor_detector  = xr_detector.actor_detector()
	self.rain_active = false
end
----------------------------------------------------------------------------------------------------------------------
function actor_binder:net_spawn(data)
	printf("actor net spawn")

	-- Сбрасываем состояние смерти после появления актёра/загрузки.
	-- UI-диалог очищается в actor_binder:net_destroy(), до пересоздания HUD.
	self.sz_death_screen_active = false
	-- Возвращаем звук после смерти (обычные значения громкости).
	get_console():execute("snd_volume_eff 1.0")
	get_console():execute("snd_volume_music 1.0")
	get_console():execute("bind_console mm_net_player_name dik_t kT")
	level.show_indicators()

	self.bCheckStart = true
	self.weapon_hide = false -- Сбрасываем локальное состояние скрытия оружия.
	weapon_hide = false -- Сбрасываем глобальный флаг скрытия оружия.

	if object_binder.net_spawn(self,data) == false then
		return false
	end
	
	sz_factions.reset_factions()
	
	sz_mod.reset_radiation_hud()
	
	if sz_healing and sz_healing.reset_healing then
		sz_healing.reset_healing(true)
	end

	db.add_actor(self.object)
	
	if self.st.disable_input_time == nil then
		level.enable_input()
	end

	self.weather_manager:reset()
--	game_stats.initialize ()

	if(actor_stats.add_to_ranking~=nil)then
		actor_stats.add_to_ranking(self.object:id())
	end

	if sz_blood and sz_blood.reset_blood then
		sz_blood.reset_blood()
	end

	-- Инициализируем настройки выпадения предметов после смерти.
	death_manager.init_drop_settings()
	news_main.filter()
	self.rain_active = false
	
	if xrs_ai then 
		xrs_ai.actor_net_spawn(self) 
	end
	return true
end
----------------------------------------------------------------------------------------------------------------------
function actor_binder:net_destroy()
	-- Сначала снимаем полноэкранный диалог смерти с HUD, пока binder/HUD ещё существуют.
	sz_mod.death_screen_cleanup()

	if sz_healing and sz_healing.reset_healing then
		sz_healing.reset_healing()
	end

    if(actor_stats.remove_from_ranking~=nil)then
		actor_stats.remove_from_ranking(self.object:id())
	end
--	game_stats.shutdown ()
	db.del_actor(self.object)

    sr_light.clean_up ()

	self.object:set_callback(callback.inventory_info, nil)
	self.object:set_callback(callback.article_info, nil)
	self.object:set_callback(callback.on_item_take, nil)
	self.object:set_callback(callback.on_item_drop, nil)
	self.object:set_callback(callback.trade_sell_buy_item, nil)
	self.object:set_callback(callback.hit, nil)
	--self.object:set_callback(callback.actor_sleep, nil)
	self.object:set_callback(callback.task_state, nil)
	self.object:set_callback(callback.level_border_enter, nil)
	self.object:set_callback(callback.level_border_exit, nil)
	self.object:set_callback(callback.take_item_from_box, nil)
	if callback.place_item_to_box ~= nil then
		self.object:set_callback(callback.place_item_to_box, nil)
	end
	if callback.on_inv_box_item_drop ~= nil then
		self.object:set_callback(callback.on_inv_box_item_drop, nil)
	end
	self.object:set_callback(callback.use_object, nil)
	self.object:set_callback(callback.entity_alive_before_hit, nil)
	self.object:set_callback(callback.on_key_press, nil)
	
	if sr_psy_antenna.psy_antenna then
		sr_psy_antenna.psy_antenna:destroy()
		sr_psy_antenna.psy_antenna = false
	end

	xr_sound.stop_all_sound_object()

	object_binder.net_destroy(self)
end
----------------------------------------------------------------------------------------------------------------------
function actor_binder:reinit()
	object_binder.reinit(self)
	
	local npc_id = self.object:id()

	db.storage[npc_id] = { }

	self.st = db.storage[npc_id]
	self.st.pstor = nil

	self.next_restrictors_update_time = -10000

	self.object:set_callback(callback.inventory_info, self.info_callback, self)
	self.object:set_callback(callback.article_info, self.article_callback, self)
	self.object:set_callback(callback.on_item_take, self.on_item_take, self)
	self.object:set_callback(callback.on_item_drop, self.on_item_drop, self)
	self.object:set_callback(callback.trade_sell_buy_item, self.on_trade, self) -- for game stats
	--self.object:set_callback(callback.actor_sleep, self.sleep_callback, self)
	self.object:set_callback(callback.task_state, self.task_callback, self)
	--self.object:set_callback(callback.map_location_added, self.map_location_added_callback, self)
	self.object:set_callback(callback.level_border_enter, self.level_border_enter, self)
	self.object:set_callback(callback.level_border_exit, self.level_border_exit, self)
	self.object:set_callback(callback.take_item_from_box, self.take_item_from_box, self)
	if callback.place_item_to_box ~= nil then
		self.object:set_callback(callback.place_item_to_box, self.place_item_to_box, self)
	end
	if callback.on_inv_box_item_drop ~= nil then
		self.object:set_callback(callback.on_inv_box_item_drop, self.on_inv_box_item_drop, self)
	end
	self.object:set_callback(callback.use_object, self.use_obj, self)
	self.object:set_callback(callback.hit, sz_mod.actor_on_hit_callback, self)
	self.object:set_callback(callback.entity_alive_before_hit, sz_mod.actor_before_hit_callback, self)
	self.object:set_callback(callback.on_key_press, self.on_key, self)
end
----------------------------------------------------------------------------------------------------------------------
function actor_binder:place_item_to_box(first, second)
    local box, item = resolve_box_and_item(first, second)
    play_item_transfer_sound(item)
end
----------------------------------------------------------------------------------------------------------------------
function actor_binder:on_inv_box_item_drop(first, second)
    -- OGSR sends this event for placing an item into an inventory/search box
    -- (including the corpse-loot window). Depending on engine revision it can
    -- provide only the item or both the box and the item.
    local item = get_single_transfer_item(first, second)
    play_item_transfer_sound(item)
end
----------------------------------------------------------------------------------------------------------------------
function actor_binder:take_item_from_box(box, item)
    -- In current OGSR inventory-box transfer code, take_item_from_box can also
    -- be dispatched after moving an item FROM the actor TO a box. Detect that
    -- direction by checking the item's actual parent before running loot logic.
    if is_item_inside_box(box, item) then
        play_item_transfer_sound(item)
        return
    end   
	-- First give player-placed rukzachok containers to sz_mod.
	-- This check must run before story_id: spawned containers may have no story id.
	if sz_mod and sz_mod.take_rucksack_item_from_box then
		if sz_mod.take_rucksack_item_from_box(box, item) then
			return
		end
	end					
	
	local story_id = box:story_id()
	if story_id == nil then
		return
	end
	
	treasure_manager.take_item_from_box(box, story_id)

	local respawner = se_respawn.get_respawner_by_parent(story_id)
	if respawner == nil then
		return
	end
	
	-- Удаляем взятый предмет из списка созданных респавнером.
	respawner:remove_spawned(item:id())

	local smart_terrain = db.strn_by_respawn[respawner:name()]
	if smart_terrain == nil then
		return
	end
	
snd_box={
	stalker = {
		[[stalker\box_1]],
		[[stalker\box_2]],
		[[stalker\box_3]],
		[[stalker\box_4]],
		[[stalker\box_5]],
		[[stalker\box_6]],
		[[stalker\box_7]],
		[[stalker\box_8]],
		[[stalker\box_9]]
	},
	dolg = {
		[[dolg\box_1]],
		[[dolg\box_2]],
		[[dolg\box_3]],
		[[dolg\box_4]],
		[[dolg\box_5]],
		[[dolg\box_6]],
		[[dolg\box_7]],
		[[dolg\box_8]]
	},
	freedom = {
		[[freedom\box_1]],
		[[freedom\box_2]],
		[[freedom\box_3]],
		[[freedom\box_4]],
		[[freedom\box_5]],
		[[freedom\box_6]],
		[[freedom\box_7]],
		[[freedom\box_8]]
	},
	bandit = {
		[[bandit\box_1]],
		[[bandit\box_2]],
		[[bandit\box_3]]
		}
}

	local npc = smart_terrain.gulag:get_nearest_online_obj(db.actor:position())
    if npc ~= nil then
	    local snd_sect = snd_box[npc:character_community()] or snd_box.stalker
		local snd = [[box_reactions\]]..snd_sect[math.random(table.getn(snd_sect))]
		snd = xr_sound.get_safe_sound_object(snd)
		snd:play_at_pos(db.actor,vector():set(0,0,1),0,sound_object.s2d)
	    xr_gulag.setGulagEnemy(smart_terrain:name() , db.actor)			
    end
end
