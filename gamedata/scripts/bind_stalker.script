function actor_binder:info_callback(npc, info_id)
    printf("*INFO*: npc='%s' id='%s'", npc:name(), info_id)
    level_tasks.proceed(self.object)
    level_tasks.process_info_portion(info_id)
end
----------------------------------------------------------------------------------------------------------------------
function actor_binder:on_trade (item, sell_bye, money)
    if sell_bye == true then
       game_stats.money_trade_update (money)
       -- The callback is invoked for the actor's sale item. Play the placement
       -- sound here as a fallback for the trader window's transfer path.
       play_item_transfer_sound(item)
    else   								     
       game_stats.money_trade_update (-money) 
    end   
end
----------------------------------------------------------------------------------------------------------------------
function actor_binder:article_callback(npc, group, name)
	--printf("article_callback [%s][%s]", group, name)
	if device().precache_frame >1 then return end
	
	if group == "Diary" then
		news_manager.send_encyclopedy("diary", group, name)
	else
		news_manager.send_encyclopedy("encyclopedy", group, name)
	end
end
----------------------------------------------------------------------------------------------------------------------
function actor_binder:on_item_take (obj)
    level_tasks.proceed(self.object)
	if xrs_ai then xrs_ai.actor_item_take(obj) end
    --game_stats.update_take_item (obj, self.object)
	sz_mod.item_take(obj)
end
----------------------------------------------------------------------------------------------------------------------
function actor_binder:on_item_drop (obj)
    level_tasks.proceed(self.object)
	--game_stats.update_drop_item (obj, self.object)
end
----------------------------------------------------------------------------------------------------------------------
function actor_binder:use_obj(obj)
    if not obj then return end
    local section = obj:section()

    -- 1. Запускаем наше лечение, если это лечебный предмет
    if sz_healing and sz_healing.is_heal_item and sz_healing.is_heal_item(section) then
        sz_healing.use_item(obj)
    end

    -- 2. Запускаем старую логику sz_mod (анимация, звук, спавн мусора)
    --    Это сработает для ВСЕХ предметов, включая аптечки
    sz_mod.start(obj)
    sz_mod.pills(obj)

    -- 3. Возвращаем false, чтобы движок сам удалил предмет и проиграл анимацию
    return false
end
----------------------------------------------------------------------------------------------------------------------

function actor_binder:task_callback(_task, _objective, _state)
	task_manager.task_callback(_task:get_id(), _objective:get_idx(), _state)
	if _objective:get_idx() == 0 then
		if _state == task.fail then
			news_manager.send_task(db.actor, "fail", _task, _objective)
		elseif _state == task.completed then
			task_manager.reward_by_task(_task)
			news_manager.send_task(db.actor, "complete", _task, _objective)
		else
			news_manager.send_task(db.actor, "new", _task, _objective)
		end
	else
		if _task:get_objective(0):get_state() == task.in_progress then
			news_manager.send_task(db.actor, "update", _task, _objective)
		end
	end
end

----------------------------------------------------------------------------------------------------------------------
function actor_binder:map_location_added_callback(spot_type_str, object_id)
	if (false==app_ready()) or (device().precache_frame>1) then return end
	--'news_manager.send_task(db.actor, "new")
end
----------------------------------------------------------------------------------------------------------------------
function actor_binder:update(delta)
	object_binder.update(self, delta)

	-- Мгновенно скрываем экран, HUD и звук при смерти актёра.
	if not self.object:alive() then
		if not self.sz_death_screen_active then
			-- Не скрываем indicators: hide_indicators также убирает наш custom static.
			sz_mod.death_screen_show()
			-- Заглушаем эффекты и музыку на уровне звуковых настроек движка.
			get_console():execute("snd_volume_eff 0.0")
			get_console():execute("snd_volume_music 0.0")
			self.sz_death_screen_active = true
		end
		-- Останавливаем уже запущенные звуковые объекты.
		pcall(xr_sound.stop_all_sound_object)
	end

	-- Восстанавливаем отложенные эффекты лечения после загрузки сохранения.
	if sz_healing and sz_healing.update then
		sz_healing.update()
	end

	-- Таймер использования предмета и возврата оружия проверяется каждый кадр.
	sz_mod.weapontimer()

	-- Refresh the contents shown in map hints for placed rukzachok containers.
	if sz_mod and sz_mod.update_rucksack_markers then
		sz_mod.update_rucksack_markers()
	end
	
	local time = time_global()
	
	if sz_mod and sz_mod.update_quicksave_archive then
		sz_mod.update_quicksave_archive(time)
	end
	
	game_stats.update(delta, self.object)

	-- Окончание перемотки проверяем каждый кадр, чтобы не задерживать возврат управления.
	if sz_wait_menu and sz_wait_menu.update_wait then
		sz_wait_menu.update_wait()
	end

	-- Дата/время в меню ожидания достаточно обновлять раз в секунду.
	if not self.last_clock_update or time - self.last_clock_update > 1000 then
		self.last_clock_update = time
		if sz_wait_menu and sz_wait_menu.update_wait_datetime then
			sz_wait_menu.update_wait_datetime()
		end
	end

	-- Основные менеджеры уровня и звука.
	self.weather_manager:update()
	self.actor_detector:update()
	xr_sound.update_actor()

	-- Возвращаем управление после завершения заданной блокировки.
	if self.st.disable_input_time ~= nil and
	   game.get_game_time():diffSec(self.st.disable_input_time) >= (self.st.disable_input_idle or 0)
	then
		level.enable_input()
		self.st.disable_input_time = nil
		self.st.disable_input_idle = nil
	end

	-- Проверка restrictors ограничена частотой 200 мс.
	if self.next_restrictors_update_time < time then
		bind_restrictor.actor_update(delta)
		self.next_restrictors_update_time = time + 200
	end

	-- Постпроцессинг обновляется каждый кадр, пока эффект существует.
	-- remove_postprocess() устанавливает nil, поэтому проверяем и nil, и 0.
	if post_process and post_process ~= 0 then
		if post_process:update() == true then
			post_process = 0
		end
	end

	if sr_psy_antenna.psy_antenna then
		sr_psy_antenna.psy_antenna:update(delta)
	end

	-- Радиометр и расписание выброса проверяются до второстепенных HUD-обновлений.
	if sz_mod and sz_mod.update_radiation then
		sz_mod.update_radiation()
	end

	if sz_mod and sz_mod.blowout_check then
		sz_mod.blowout_check()
	end

	if sz_helmet_system and sz_helmet_system.update then
		sz_helmet_system.update(self.object)
	end

	-- HUD и фоновые игровые обновления. У ряда функций уже есть свои интервалы.
	sz_mod.show_time()
	sz_mod.rank_up()
	sz_mod.armor_static()

	sz_dynmusic.update()
	sz_factions.update_factions()

	if dik_hot_keys and dik_hot_keys.update then
		dik_hot_keys.update()
	end

	-- Скрытие оружия на время разговора.
	if weapon_hide == true or self.object:is_talking() then
		if self.weapon_hide == false then
			self.object:hide_weapon()
			self.weapon_hide = true
		end
	else
		if self.weapon_hide == true then
			self.object:restore_weapon()
			self.weapon_hide = false
		end
	end

	-- Всплывающее предупреждение при высоком уровне радиации.
	local hud = get_hud()
	if hud then
		if self.object.radiation >= 0.7 then
			local custom_static = hud:GetCustomStatic("cs_radiation_danger")
			if custom_static == nil then
				hud:AddCustomStatic("cs_radiation_danger", true)
				custom_static = hud:GetCustomStatic("cs_radiation_danger")
				if custom_static then
					custom_static:wnd():SetTextST("st_radiation_danger")
				end
			end
		elseif hud:GetCustomStatic("cs_radiation_danger") ~= nil then
			hud:RemoveCustomStatic("cs_radiation_danger")
		end
	end

	-- Дождь: включаем/выключаем эффект только при смене состояния.
	local rain_now = level.rain_factor() > 0.07
	if rain_now and not self.rain_active then
		level.add_pp_effector("rain.ppe", 2010, true, "")
		if hud then
			hud:AddCustomStatic("hud_rain", true)
		end
		self.rain_active = true
	elseif not rain_now and self.rain_active then
		level.remove_pp_effector(2010)
		if hud and hud:GetCustomStatic("hud_rain") then
			hud:RemoveCustomStatic("hud_rain")
		end
		self.rain_active = false
	elseif rain_now and self.rain_active and hud and not hud:GetCustomStatic("hud_rain") then
		-- Если HUD появился позже эффекта дождя, создаём индикатор.
		hud:AddCustomStatic("hud_rain", true)
	end

	if self.bCheckStart then
		printf("SET DEFAULT INFOS")

		if not has_alife_info("storyline_actor_start") and level.name() == "l01_escape" then
			self.object:give_info_portion("storyline_actor_start")
			_G.g_start_avi = true
			printf("*AVI* RUN START AVI")
		end

		if not has_alife_info("from_ship_to_bal_start") then
			self.object:give_info_portion("from_ship_to_bal_start")
		end

		if not has_alife_info("global_dialogs") then
			self.object:give_info_portion("global_dialogs")
		end

		level_tasks.add_lchanger_location()
		self.bCheckStart = false
	end

	if xrs_ai then
		xrs_ai.actor_update(delta)
	end

	if sz_blood and sz_blood.update_blood_splatters then
		sz_blood.update_blood_splatters()
	end

	if dinamic_hud then
		dinamic_hud.update()
	end

	if sz_hunger_effect and sz_hunger_effect.update_hunger_effect then
		sz_hunger_effect.update_hunger_effect()
	end

	news_main_data.show_news_main()
	
end
----------------------------------------------------------------------------------------------------------------------
function actor_binder:save(packet)
	
	local save_treasure_manager = true
	
	printf("actor_binder:save(): self.object:name()='%s'", self.object:name())
	object_binder.save(self, packet)

	-- Сохраняем уровень сложности.
	if save_treasure_manager == true then
		packet:w_u8(level.get_game_difficulty() + 128)
	else
		packet:w_u8(level.get_game_difficulty())
	end

	-- Сохраняем состояние временного отключения управления.
	if self.st.disable_input_time == nil then
		packet:w_bool(false)
	else
		packet:w_bool(true)
		utils.w_CTime(packet, self.st.disable_input_time)
	end

	xr_logic.pstor_save_all(self.object, packet)
	self.weather_manager:save(packet)

	sr_psy_antenna.save( packet )
	
	if save_treasure_manager == true then
		treasure_manager.save(packet)      
	end                                  

	task_manager.save(packet)
	self.actor_detector:save(packet)

	-- Расширение пакета: длительность блокировки управления и активное лечение.
	-- Старые сохранения распознаются по отсутствию маркера в конце пакета.
	packet:w_u8(0xA6)
	local disable_idle_ms = math.max(0, math.floor((self.st.disable_input_idle or 0) * 1000))
	packet:w_u32(disable_idle_ms)
	if sz_healing and sz_healing.save_healing_state then
		sz_healing.save_healing_state(packet)
	else
		packet:w_u8(0)
	end

	if sz_mod and sz_mod.on_quicksave_actor_save then
		sz_mod.on_quicksave_actor_save()
	end
	
end
----------------------------------------------------------------------------------------------------------------------
function actor_binder:load(reader)
	printf("actor_binder:load(): self.object:name()='%s'", self.object:name())
	if sz_healing and sz_healing.reset_healing then
		sz_healing.reset_healing()
	end
	object_binder.load(self, reader)
	printf("actor_binder:object_binder.load(): self.object:name()='%s'", self.object:name())

	-- Загружаем уровень сложности.
	local game_difficulty = reader:r_u8()
	
	local load_treasure_manager = false      
	if game_difficulty >= 128 then           
		game_difficulty = game_difficulty - 128
		load_treasure_manager = true           
	end                                      

	
	local difficulty_section = game_difficulty_by_num[game_difficulty]
	if difficulty_section then
		get_console():execute("g_game_difficulty "..difficulty_section)
	else
		printf("[BIND] unsupported saved game difficulty: %s", tostring(game_difficulty))
	end

	if reader:r_eof() then
		abort("SAVE FILE IS CORRUPT")
	end

	local stored_input_time = reader:r_u8() ~= 0
	if stored_input_time then
		self.st.disable_input_time = utils.r_CTime(reader)
	else
		self.st.disable_input_time = nil
	end

	xr_logic.pstor_load_all(self.object, reader)
	self.weather_manager:load(reader)

	sr_psy_antenna.load(reader)
	
	if load_treasure_manager == true then
		treasure_manager.load(reader)      
	end                                  

	
	task_manager.load(reader)
	self.actor_detector:load(reader)

	-- Читаем добавочный блок только если он есть. Старые сохранения
	-- заканчиваются на actor_detector и не требуют дополнительных чтений.
	self.st.disable_input_idle = nil
	if not reader:r_eof() then
		local marker = reader:r_u8()
		if marker == 0xA6 then
			local disable_idle_ms = reader:r_u32()
			if self.st.disable_input_time ~= nil then
				self.st.disable_input_idle = disable_idle_ms / 1000
			end

			if sz_healing and sz_healing.load_healing_state then
				sz_healing.load_healing_state(reader)
			else
				local count = reader:r_u8()
				for i = 1, count do
					reader:r_stringZ()
					reader:r_u32()
				end
			end
		else
			printf("[BIND] unknown actor save extension marker: %s", tostring(marker))
		end
	end

	-- В старых сохранениях длительность блокировки не записывалась.
	if self.st.disable_input_time ~= nil and self.st.disable_input_idle == nil then
		self.st.disable_input_idle = 0
	end
end
----------------------------------------------------------------------------------------------------------------------
function actor_binder:on_key(key)
    if not db.actor or not db.actor:alive() then return end

    if key == DIK_keys.DIK_F6 then
        if sz_mod and sz_mod.request_quicksave_archive then
            sz_mod.request_quicksave_archive()
        end
		
    elseif key == DIK_keys.DIK_F7 then
        -- Archive the just-created F6 save before the engine loads the
        -- fixed user_quicksave slot and the pending update can be interrupted.
        if sz_mod and sz_mod.flush_quicksave_archive then
            sz_mod.flush_quicksave_archive()
        end
		
    elseif key == DIK_keys.DIK_T then
        if sz_wait_menu then
            if sz_wait_menu.is_wait_menu_open() then
                sz_wait_menu.close_wait_menu()
            else
                sz_wait_menu.open_wait_menu()
            end
        end
    end
end

