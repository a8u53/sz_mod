function check_money()
	return db.actor:money()>=150
end

function check_money_2()
	return db.actor:money()>=750
end

function check_money_3()
	return db.actor:money()>=500
end

function check_money_4()
	return db.actor:money()>=1000
end

function conductor_talk()
   	local pizdesh = {"Ну вот мы и пришли.",
					 "Мы на месте. До встречи.",
					 "Добрались таки, удачи.",
					 "Пришли, если понадоблюсь опять, ты знаешь где меня найти."
					 }

	conductor_msg = pizdesh[math.random(table.getn(pizdesh))]
    local news_text = "%c[205,145,145,160]\"Проводник\"\\n%c[default]" ..conductor_msg
		news_sound()
	db.actor:give_game_news(news_text, "ui\\ui_iconsTotal", Frect():set(498,282,83,47), 1000, 4000)
end

function news_sound()
local snd_obj
snd_obj = xr_sound.get_safe_sound_object([[device\pda\pda_tip]]) -- путь до звукового файла
snd_obj:play_no_feedback(db.actor, sound_object.s2d, 1, vector(), 1.0)
end