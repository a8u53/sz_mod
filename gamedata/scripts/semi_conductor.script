function dark_valley(npc, actor)
npc:stop_talk()
actor:stop_talk()
dialogs.relocate_money(actor, 500, "out")
db.actor:set_actor_position(vector():set(346,26,-37),588161,140)
level.add_pp_effector ("peace_unfade.ppe", 2006, false)
conductor_talk()	
end

