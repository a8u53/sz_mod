haracters_voice\scenario\yantar\ghost_pda]]),    yan_saharov_message 			= xr_sound.get_safe_sound_object([[characters_voice\scenario\yantar\professor_to_actor_pda_3]]),	yan_saharov_message_2 			= xr_sound.get_safe_sound_object([[characters_voice\scenario\yantar\professor_to_actor_pda_4]]),    yan_saharov_message_3 			= xr_sound.get_safe_sound_object([[characters_voice\scenario\yantar\professor_to_actor_pda_5]]),		yan_scientist_probe				= xr_sound.get_safe_sound_object([[characters_voice\scenario\yantar\kruglov_radiation_quest_13]]),	yan_scientist_probe_1			= xr_sound.get_safe_sound_object([[characters_voice\scenario\yantar\kruglov_radiation_quest_11]]),	yan_scientist_probe_2			= xr_sound.get_safe_sound_object([[characters_voice\scenario\yantar\kruglov_radiation_quest_12]]),	yan_scientist_probe_3			= xr_sound.get_safe_sound_object([[characters_voice\scenario\yantar\kruglov_radiation_quest_6]]),		rostok_kruglov_follow			= xr_sound.get_safe_sound_object([[characters_voice\scenario\Rostok\pda_kruglov_help_6]]),	bar_freedom_chase			= xr_sound.get_safe_sound_object([[characters_voice\scenario\Rostok\pda_kruglov_stop_enemy_1]]),	rostok_kruglov_follow_2			= xr_sound.get_safe_sound_object([[characters_voice\scenario\Rostok\pda_kruglov_stop_enemy_2]]),	rostok_kruglov_follow_3			= xr_sound.get_safe_sound_object([[characters_voice\scenario\Rostok\pda_kruglov_help_5]]),			bar_territory_dolg_1_hit		= xr_sound.get_safe_sound_object([[characters_voice\scenario\bar\pda\voronin_gunfire_pda_1]]),	bar_territory_dolg_2_hit		= xr_sound.get_safe_sound_object([[characters_voice\scenario\bar\pda\voronin_gunfire_pda_2]]),	bar_territory_dolg_3_hit		= xr_sound.get_safe_sound_object([[characters_voice\scenario\bar\pda\voronin_gunfire_pda_3]]),	bar_territory_dolg_kill			= xr_sound.get_safe_sound_object([[characters_voice\scenario\bar\pda\voronin_gunfire_pda_4]]),		tips_bun_komand                 = xr_sound.get_safe_sound_object([[characters_voice\scenario\bun\patrol_prikaz]]),	general_ecolog_tip_1            = xr_sound.get_safe_sound_object([[characters_voice\scenario\yantar\professor_to_actor_pda_1]]),    general_ecolog_tip_2            = xr_sound.get_safe_sound_object([[characters_voice\scenario\yantar\professor_to_actor_pda_2]]),    tips_gar_hellcar_alarm			= xr_sound.get_safe_sound_object([[characters_voice\scenario\garbage\neutrals_commander_pda_1]]),	gar_dolg_blokpost_warning		= xr_sound.get_safe_sound_object([[characters_voice\scenario\duty\duty_warning1]]),	gar_dolg_monster_rush			= xr_sound.get_safe_sound_object([[characters_voice\scenario\duty\duty_request1]]),	gar_direction_fire				= xr_sound.get_safe_sound_object([[characters_voice\scenario\garbage\junkyard_combat_ambush]]),	gar_hellcar_victory				= xr_sound.get_safe_sound_object([[characters_voice\scenario\garbage\junkyard_combat_end]]),	gar_actor_looser				= xr_sound.get_safe_sound_object([[characters_voice\scenario\garbage\duty_after_rush_bad]]),	gar_actor_normal				= xr_sound.get_safe_sound_object([[characters_voice\scenario\garbage\duty_after_rush_normal]]),	gar_actor_winner				= xr_sound.get_safe_sound_object([[characters_voice\scenario\garbage\duty_after_rush_good]]),	esc_direction_fire				= xr_sound.get_safe_sound_object([[characters_voice\scenario\escape\lager_fanat_attack]]),	esc_fanat_victory				= xr_sound.get_safe_sound_object([[characters_voice\scenario\escape\lager_fanat_victory]]),		rad_barman_spam					= xr_sound.get_safe_sound_object([[characters_voice\scenario\radar\rad_barman_message]]),	val_monolith_trader_pda1		= xr_sound.get_safe_sound_object([[characters_voice\scenario\val\trader_dialog1]]),	o_soznanie_text					= xr_sound.get_safe_sound_object([[characters_voice\scenario\sarcofag\o_soznanie_call]]),-- dublicate pda sounds for remark scheme    val_rob_leader_jeer_1           = xr_sound.get_safe_sound_object([[characters_voice\scenario\val\rob_leader_jeer_1_p]]),--    val_rob_leader_call             = xr_sound.get_safe_sound_object([[characters_voice\scenario\val\rob_call_1_p]]),    pri_followers_leader_phrase1_1  = xr_sound.get_safe_sound_object([[characters_voice\scenario\pri\followers_leader_phrase1_1_p]]),    pri_followers_leader_phrase1_2  = xr_sound.get_safe_sound_object([[characters_voice\scenario\pri\followers_leader_phrase1_2_p]]),    pri_followers_leader_phrase1_3  = xr_sound.get_safe_sound_object([[characters_voice\scenario\pri\followers_leader_phrase1_3_p]]),}pda_news = xr_sound.get_safe_sound_object([[device\pda\pda_news]])pda_tips = xr_sound.get_safe_sound_object([[device\pda\pda_tip]])pda_task = xr_sound.get_safe_sound_object([[device\pda\pda_objective]])tips_icons = {	default  = { 0, 658},	trader	 = { 332, 893},	dolg     = { 498, 188},	freedom  = { 498, 235},	ecolog   = { 498, 0},	arena    = { 332, 141},	stalker  = { 0, 658},	krot     = { 332, 47},	barman   = { 332, 235},	wolf	 = { 332, 940},	o_soznanie = { 498, 893},	monolith = { 166, 940},    saharov  = { 332, 470},    prizrak  = { 415, 705},    killer   = { 332, 517}}local function resolve_news_actor(actor)	if actor ~= nil then return actor end	if db ~= nil then return db.actor end	return nilendfunction send_tip(actor, news_id, timeout, sender, showtime, sender_id)	local recipient = resolve_news_actor(actor)	if not recipient or news_id == nil then return false end	printf("try to send tips for [%s]", tostring(sender_id))	if sender_id ~= nil then		local sim = alife()		if sim ~= nil then			local ok, npc = pcall(function() return sim:story_object(sender_id) end)			if ok and npc ~= nil then				if npc.online and xr_wounded and xr_wounded.is_heavy_wounded_by_id then					-- В онлайне проверяем на тяжёлое ранение.					if xr_wounded.is_heavy_wounded_by_id(npc.id) then						printf("[PDA]Cannot send tips [%s], sender is heavy wounded", tostring(news_id))						return false					end				end				-- Мёртвый отправитель не должен присылать новые подсказки.				-- alive() у ALife-существа возвращает boolean, а не число 1.				local alive_ok, alive_state = pcall(function() return npc:alive() end)				if alive_ok and not alive_state then					printf("[PDA]Cannot send tips [%s], sender is dead", tostring(news_id))					return false				end			end		end	end	timeout = tonumber(timeout) or 0	showtime = tonumber(showtime) or 5000	if timeout < 0 then timeout = 0 end	if showtime < 0 then showtime = 0 end	-- Стандартный звук PDA.	if pda_tips then		pda_tips:play(recipient, timeout, sound_object.s2d)	end	-- Голосовая реплика, если для news_id задан звуковой объект.	local news_sound = news[news_id]	if news_sound then		news_sound:play(recipient, timeout + 1, sound_object.s2d)		local length = news_sound:length()		if length and length > showtime then			showtime = length		end	end	-- Неизвестный отправитель использует стандартную иконку.	local icon = tips_icons[sender] or tips_icons.default	local x = icon and icon[1] or 0	local y = icon and icon[2] or 658	local news_text = "%c[255,160,160,160]" .. game.translate_string("st_tip") .. "\\n" .. "%c[default]" .. game.translate_string(tostring(news_id))	recipient:give_game_news(news_text, "ui\\ui_iconsTotal", Frect():set(x, y, 83, 47), timeout * 1000, showtime)	return trueendfunction send_tip_nosound(actor, news_id, timeout, sender)	local recipient = resolve_news_actor(actor)	if not recipient or news_id == nil then return nil end	-- Эта функция намеренно не запускает голосовую реплику:	-- она возвращает sound object вызывающему коду.	if pda_tips then		pda_tips:play(recipient, 0, sound_object.s2d)	end	return news[news_id]endlocal action_descr_by_type = {	new = "general_new_task",	update = "general_update_task",	complete = "general_complete_task",	fail = "general_fail_task"}function send_task(actor, task_type, task, objective)	local recipient = resolve_news_actor(actor)	if not recipient or not task then return false end	local action_text = action_descr_by_type[task_type]	if not action_text then		printf("[PDA]Unknown task notification type [%s]", tostring(task_type))		return false	end	local task_id = task:get_id()	local task_title = task:get_title()	if task_id == nil or task_title == nil then return false end	-- Берём координаты из текстуры задания.	local task_texture, task_rect = get_texture_info("ui_iconsTotal_" .. tostring(task_id), "ui_iconsTotal_locations")	if pda_task then		pda_task:play(recipient, 0, sound_object.s2d)	end	local news_text = "%c[255,160,160,160]" .. game.translate_string(action_text) .. "\\n" .. "%c[default]" .. game.translate_string(task_title)	if recipient:is_talking() then		recipient:give_talk_message(news_text, task_texture, task_rect, "iconed_trade_info")	else		recipient:give_game_news(news_text, task_texture, task_rect, 0, 3000)	end	-- Подсказка со следующим objective нужна только при наличии следующей цели.	if objective ~= nil then		local objective_index = objective:get_idx()		local objective_count = task:get_objectives_cnt()		if objective_index ~= nil and objective_count ~= nil then			if objective_index + 1 >= objective_count then				return true			end			local next_objective = task:get_objective(objective_index + 1)			if next_objective ~= nil then				local description = next_objective:get_description()				if description ~= nil then					news_text = game.translate_string(description)				end			end		end	end	local hud = get_hud()	if hud then		local custom_static = hud:GetCustomStatic("main_task")		if custom_static == nil then			hud:AddCustomStatic("main_task", true)			custom_static = hud:GetCustomStatic("main_task")		end		if custom_static ~= nil then			custom_static:wnd():SetTextST(news_text)			custom_static.m_endTime = time_global() / 1000 + 5		end	end	return trueendfunction send_encyclopedy(entry_type, group, name)	if entry_type == "task" then return false end	local recipient = resolve_news_actor(nil)	if not recipient or group == nil or name == nil then return false end	local task_texture, task_rect = get_texture_info("ui_iconsTotal_bar_darklab_documents2")	local news_text = "%c[255,160,160,160]" .. game.translate_string("Добавлена статья энциклопедии:") .. "\\n" .. "%c[124,247,136,1]" .. game.translate_string(tostring(group)) .. ": " .. "%c[default]" .. game.translate_string(tostring(name))	if recipient:is_talking() then		recipient:give_talk_message(news_text, task_texture, task_rect, "iconed_answer_item")	else		recipient:give_game_news(news_text, task_texture, task_rect, 0, 3000)	end	return trueendfunction send_treasure(name, stash_description)	local recipient = resolve_news_actor(nil)	if not recipient or name == nil then return false end	local level_name = {		esc = "Кордон",		gar = "Свалка",		agr = "НИИ Агропром",		agru = "Подвалы Агропрома",		val = "Темная Долина",		mil = "Армейские склады",		yan = "Янтарь",		x16 = "Лаборатория x16",		rad = "Радар",		pri = "Припять",		x18 = "Лаборатория x18",		bar = "Бар",		ros = "Дикая территория",		dc = "Мёртвый город",		lim = "Лиманск"	}	if pda_news then		pda_news:play(recipient, 0, sound_object.s2d)	end	local task_texture, task_rect = get_texture_info("ui_iconsTotal_found_thing")	local stash_name = tostring(name)	local marker = string.find(stash_name, "_s", 1, true)	local level_key = marker and string.sub(stash_name, 1, marker - 1) or nil	local level_prefix = level_key and level_name[level_key] or nil	local location_text = level_prefix and (level_prefix .. ": ") or ""	local description_text = stash_description and game.translate_string(tostring(stash_description)) or ""	local news_text = "%c[255,160,160,160]" .. game.translate_string("st_found_new_treasure") .. "\\n" .. "%c[124,247,136,1]" .. location_text .. "%c[default]" .. game.translate_string(stash_name) .. "\\n" .. description_text	recipient:give_game_news(news_text, task_texture, task_rect, 0, 3000)	return trueendfunction emptied_stash(stash_name)	local recipient = resolve_news_actor(nil)	if not recipient or stash_name == nil then return false end	local task_texture, task_rect = get_texture_info("ui_iconsTotal_found_thing")	local news_text = "%c[255,160,160,160]Обнаружен тайник\\n%c[124,247,136,1]" .. game.translate_string(tostring(stash_name))	recipient:give_game_news(news_text, task_texture, task_rect, 0, 3000)	if pda_tips then		pda_tips:play(recipient, 0, sound_object.s2d)	end	return trueendfunction get_inv_name(section)	if section == nil then return "" end	local ini = system_ini()	if not ini then return tostring(section) end	local ok, inv_name = pcall(function() return ini:r_string(section, "inv_name") end)	if ok and inv_name ~= nil and inv_name ~= "" then		return inv_name	end	return tostring(section)endfunction relocate_item(actor, move_type, item)	local recipient = resolve_news_actor(actor)	if not recipient or item == nil then return false end	if move_type ~= "in" and move_type ~= "out" then return false end	local item_name = game.translate_string(get_inv_name(item))	local task_texture, task_rect	local news_text	if move_type == "in" then		task_texture, task_rect = get_texture_info("ui_iconsTotal_found_thing")		news_text = "%c[255,160,160,160]" .. game.translate_string("general_in_item") .. "\\n%c[default]" .. item_name	else		task_texture, task_rect = get_texture_info("ui_iconsTotal_lost_thing")		news_text = "%c[255,160,160,160]" .. game.translate_string("general_out_item") .. "\\n%c[default]" .. item_name	end	if recipient:is_talking() then		recipient:give_talk_message(news_text, task_texture, task_rect, "iconed_answer_item")	else		recipient:give_game_news(news_text, task_texture, task_rect, 0, 3000)	end	return trueendfunction relocate_money(actor, move_type, amount)	local recipient = resolve_news_actor(actor)	if not recipient or amount == nil then return false end	if move_type ~= "in" and move_type ~= "out" then return false end	local amount_text = game.translate_string(tostring(amount))	local task_texture, task_rect	local news_text	if move_type == "in" then		task_texture, task_rect = get_texture_info("ui_iconsTotal_found_money")		news_text = "%c[255,160,160,160]" .. game.translate_string("general_in_money") .. "\\n%c[default]" .. amount_text	else		task_texture, task_rect = get_texture_info("ui_iconsTotal_lost_money")		news_text = "%c[255,160,160,160]" .. game.translate_string("general_out_money") .. "\\n%c[default]" .. amount_text	end	if recipient:is_talking() then		recipient:give_talk_message(news_text, task_texture, task_rect, "iconed_answer_item")	else		recipient:give_game_news(news_text, task_texture, task_rect, 0, 3000)	end	return trueend