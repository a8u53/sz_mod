function checkStalker(npc_community, gulag_type, npc_rank, se_obj)
	if gulag_type == "cit_bandits" then
		return npc_community == "bandit"
	end

	if gulag_type == "cit_bandits_gate1" then
		return npc_community == "bandit"
	end

	if gulag_type == "cit_bandits_base" then
		return npc_community == "bandit"
	end
	
	if gulag_type == "cit_killers" then
		return npc_community == "killer"
	end	
	
	if gulag_type == "cit_killers_base" then
		return npc_community == "killer"
	end	

	if gulag_type == "cit_killers_snipers" then
		return npc_community == "killer"
	end	
	
	return false
end

function checkMonster(npc_community, gulag_type)

	if gulag_type == "cit_kanaliz1" then
		return npc_community == "snork"
	end
	
	return false
end