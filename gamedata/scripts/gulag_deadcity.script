function load_states(gname, type)
	if type == "cit_bandits" then
		return function(gulag)
			return 0
		end
	end
	
	if type == "cit_bandits_gate1" then
		return function(gulag)
			return 0
		end
	end
	
	if type == "cit_bandits_base" then
		return function(gulag)
			return 0
		end
	end

	if type == "cit_killers_base" then
		return function(gulag)
			return 0
		end
	end
	
	if type == "cit_killers" then
		return function(gulag)
			return 0
		end
	end
	
	if type == "cit_killers_snipers" then
		return function(gulag)
			return 0
		end
	end

	if type == "cit_kanaliz1" then
		return function(gulag)
			return 0
		end
	end
	
	return nil
end

