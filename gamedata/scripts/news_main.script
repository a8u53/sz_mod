local dolg_news={
"%c[255,255,0,0]\"Долг\"\\n%c[default]У нас проблемы с оборудованием, в течение пары суток может барахлить связь с базой и квадами.",
"%c[255,255,0,0]\"Долг\"\\n%c[default]Сталкеры, вступайте в \"Долг\". Защитим планету от заразы Зоны!",   
"%c[255,255,0,0]\"Долг\"\\n%c[default]У нас проблемы с оборудованием, в течение пары суток может барахлить связь с базой и квадами.",
"%c[255,255,0,0]\"Долг\"\\n%c[default]4-й квад, где данные о ходе разведрейда? Доложите, есть-ли потери в кваде!",
"%c[255,255,0,0]\"Долг\"\\n%c[default]3-й квад, рейд за монстрами для арены, никто не отменял! А ну, вылезли из бара! К анархистам захотели?!"
}

local freedom_news={
"%c[255,34, 139, 34]\"Свобода\"\\n%c[default]Да здравствует \"Свобода\"! Сделаем мир при помощи Зоны лучше!",
"%c[255,34, 139, 34]\"Свобода\"\\n%c[default]Вступайте в \"Свободу\"! Остановим захват Зоны!",
"%c[255,34, 139, 34]\"Свобода\"\\n%c[default]Одиночки! Говорит \"Свобода\"! Если хотите жить в нормальных условиях в Зоне и без армейской обязаловки, как у \"Долга\" - двигайте к нам! Всегда рады новым лицам.",
"%c[255,34, 139, 34]\"Свобода\"\\n%c[default]Всем нашим - срочно зайти в приватный канал, обновляем защиту. Потом не жалуйтесь, что о вашем рейде \"Долг\" узнал.",
"%c[255,34, 139, 34]\"Свобода\"\\n%c[default]Если находитесь на задании, всю информацию - в приватный канал. Этот не только наши читают, не палитесь.",
"%c[255,34, 139, 34]\"Свобода\"\\n%c[default]Лукаш! Смену, на Барьер, ждём уже 3-й день, задолбались уже..."
}

noname_teamletes = {
	"%c[255,160,255,160]Скрыто\\n%c[default]Я на Свалке, тут дофига слепых псов набежало…\\nПохоже из центра пришли новые стаи, всем быть осторожнее.",
	"%c[255,160,255,160]Скрыто\\n%c[default]…худо мне, ребята, зацепило таки меня. Если кто возле ржавого озера, подсобите, за мной не заржавеет… \\nВ общем, постараюсь сам выкарабкаться, а там посмотрим.",
	"%c[255,160,255,160]Квад\\n%c[default]Наблюдаем волну мутантов, идет с северо-запада, см. приложенные координаты.",
	"%c[255,160,255,160]Квад\\n%c[default]Наблюдаем волну мутантов, идет из северного ущелья.",
	"%c[255,160,255,160]Квад\\n%c[default]Наблюдаем волну мутантов, идет с востока, предположительно - из Темной долины.",
	"%c[255,160,255,160]ID не зарегистрирован в системе\\n%c[default]Спасите, стая псов прет прямо на нас, точные координаты прилагаю!",
	"%c[255,160,255,160]Скрыто\\n%c[default]Мародеры, твари... Всю Припять разрушили, жалко, я там вырос.",
	"%c[255,160,255,160]Скрыто\\n%c[default]Псевдособака набросилась, еле пристрелил!",
	"%c[255,160,255,160]Скрыто\\n%c[default]Видел группу каких-то левых мужиков, предположительно Свобода, идут в сторону Бара",
	"%c[255,160,255,160]Скрыто\\n%c[default]Группа из пяти человек движется в сторону Заслона, предположительно, это Монолит. Примите меры.",
	"%c[255,160,255,160]Скрыто\\n%c[default]Не суйтесь в Темную Долину, оттуда щас лезут зомбаки, толпами… Берегите патроны, млин. Давно уже пора было зачистить долину. И куда только Долг смотрит?",
	"%c[255,160,255,160]Скрыто\\n%c[default]Два-три-семь, идем домой, встречайте.",
	"%c[255,160,255,160]Скрыто\\n%c[default]Мародеры зажали, выручайте!",
	"%c[255,160,255,160]Скрыто\\n%c[default]Слышал переговоры военных, у них планируется какая-то операция на Янтаре.",
	"%c[255,160,255,160]Алкаш Программист\\n%c[default]Нужен выход в интернет. В баре есть, или к Сидоровичу плестись?",
    "%c[255,160,255,160]Сидорович\\n%c[default]Нынче опасно жить и быть торговцем, нужны люди для охраны, меня и моих сбережений!",
    "%c[255,160,255,160]Бармен\\n%c[default]Хе-Хе, Меченый, я подогнал денежного клиента, срочно выйди на связь!",
	"%c[255,160,255,160]Рома\\n%c[default]Требуется сталкер, специалист по кодовым замкам, с опытом рейдов на север зоны.",
	"%c[255,160,255,160]Инкогнито\\n%c[default]Я слышал, что американцы к нам какого-то своего супермена заслали. Интересно будет на него посмотреть.",
	"%c[255,160,255,160]Источник неизвестен\\n%c[default]В подвалы не суйтесь, там тварей полно! Обходите поверху!",
	"%c[255,160,255,160]Инкогнито\\n%c[default]Народ! Осторожнее в деревне на складах - там Жгучего Пуха намело на столбы!",
	"%c[255,160,255,160]Инкогнито\\n%c[default]Аллё, герои, мать вашу! Харэ пытаться нас с АТП выбить! Если какая падла ещё не врубилась, это наша территория и не хрена лезть к нам!",
	"%c[255,160,255,160]Источник неизвестен\\n%c[default]Блин! Ё-моё, снова зомби полным-полно на Янтаре! Аккуратней там, народ!",
	"%c[255,160,255,160]Инкогнито \\n%c[default]Сталкеры! Сахаров даёт неплохие деньги за хабар! И всё ищет, кого бы в Х-16  послать... Я что-то не рискую... Фонит там дико, да и зомби...",
	"%c[255,160,255,160]Лысый \\n%c[default]В Темной Долине опять бандиты объявились. Нехорошо. Будем искоренять.",
	"%c[255,160,255,160]Крот \\n%c[default]Набираю людей для вылазки в катакомбы.",
	"%c[255,160,255,160]Крот\\n%c[default]Нужны двое сталкеров для вылазки в катакомбы.",
	"%c[255,160,255,160]Старый\\n%c[default]Нужны сталкеры с опытом рейдов вглубь Зоны. Оплата соответствующая. Заинтересованным - стучать в личку, обговорим место встречи.",
	"%c[255,160,255,160]Фанат \\n%c[default]Волк, отзовись, поговорить надо. Сколько можно повторять? Где ты пропал?",
	"%c[255,160,255,160]Бармен\\n%c[default]Так... объясняю раз и навсегда - я не скажу, где находится центр связи.",
	"%c[255,160,255,160]Фанат\\n%c[default]Волк, отзовись, поговорить надо.",
	"%c[255,160,255,160]Петренко\\n%c[default]Повторяю, проход на базу - строго по пропускам или моему распоряжению.",
    "%c[255,160,255,160]Сахаров\\n%c[default]Личная просьба от меня, если кто находится рядом с моим убежищем и не стеснен в боеприпасах, пожалуйста убейте снорков на болотах, они мне жизни не дают!",
    "%c[255,160,255,160]Рафык\\n%c[default]Рэшим ваши праблэми с канкурэнтами. Дорага. Спраси Ару, да? Будэм окала Бара.",
    "%c[255,160,255,160]Рафык \\n%c[default]Э, кто в Барэ про мэня трэпался? Узнаю, зарэжу, да",
    "%c[255,160,255,160]Иван Сцикун\\n%c[default]Слышали новость: кто-то опять хочет к Выжигателю пробиться. Боязно!",
    "%c[255,160,255,160]Скрыто \\n%c[default]Говорят у Сахарова новые детекторы есть!",
    "%c[255,160,255,160]Андрій Патріот\\n%c[default]Во, млін, москалів понаїхало",
    "%c[255,160,255,160]Ярик Петух\\n%c[default]В Тёмной Долине какой-то левый лошара бродит - а волына у него классная - если кто его обует - куплю ту волыну",
	"%c[255,160,255,160]Санек\\n%c[default]Кто нибудь помог...",
	"%c[255,160,255,160]Теодор\\n%c[default]Куплю кота, породы сиамские близнецы :)",
	"%c[255,160,255,160]Теодор\\n%c[default]Отправьте это сообщение 10 своим друзьям и у вас будет щастье.",
	"%c[255,160,255,160]Теодор\\n%c[default]Лев собрал зверей и говорит:\\n- Кто прыгнет со скалы, тот поимеет мою львицу.\\nНе успев договорить, видит со скалы падает медведь и карабкается обратно. Лев:\\n- Миша, куда ты? Ты же первый, поимей мою львицу!\\n- Подожди, Лева! я сначала поимею того козла, который меня оттуда скинул!",
	"%c[255,160,255,160]Бык\\n%c[default]Теодор, ты реально достал, если не хочешь проблем, завязывай.",
	"%c[255,160,255,160]Урюк\\n%c[default]Собираю рейд в центр Зоны.",
	"%c[255,160,255,160]Кулак\\n%c[default]Куплю вазелин (не спрашивайте зачем).",	
	"%c[255,160,255,160]Жмых\\n%c[default]Теодор, ты заколебал со своим базаром честное слово, найду шею сверну.",
	"%c[255,160,255,160]Сидорович\\n%c[default]Шустрый, зайди ко мне, дело есть.",
	"%c[255,160,255,160]Теодор\\n%c[default]Анекдот, я ржал. \\nВисят как-то летучие мыши на перекладине. Висят себе, висят, вниз головой, как полагается. Вдруг одна переворачивается и встает головой вверх. Другая смотрит на нее с превеликим удивлением и спрашивает у третьей:\\n- Слушай, что это с ней?\\n- Да, не обращай внимания. Опять сознание потеряла.",
    "%c[255,160,255,160]Балбес\\n%c[default]Продам ВСС Винторез (с уменьшением отдачи, и увеличением начальной скорости пули) в Темной долине под мостом около болота."
}


