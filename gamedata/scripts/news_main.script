--Смерть
function show_death_news()
    local dead_messages = ""
    if math.random() < post_message_death then
        dead_messages = dead_reason[math.random(#dead_reason)]
    end
    if (dead_messages ~= "") then
        local sname = snames[math.random(#snames)]
        local victim = snames[math.random(#snames)]
        local from = ""..sname
        local who = ""..victim
        local news_text = "%c[255,255, 99, 71]" .. from ..":\\n%c[default]Погиб: ".. who .."%c[default] Причина:" .. dead_messages
        db.actor:give_game_news(news_text, "ui\\ui_iconsTotal", Frect():set(0,752,83,47), 0, 7000)
    end
end



function game_minutes()
    local gtime = level.get_time_days()*60*24+level.get_time_hours()*60+level.get_time_minutes()  --время в игровых минутах
    return gtime
end

monsters = { "псевдогигант", "снорк", "кровосос", "полтергейст", "бюрер", "химера", "зомби", "контролёр", "псевдособака", "собака", "плоть", "тушкан", "кабан"}


function show_news_trade()
    local trade_maseges = ""
    if math.random() < post_message_prob2 then
        trade_maseges = trade_templates[math.random(#trade_templates)]
    end
    if (trade_maseges ~= "") then
        local sname = snames[math.random(#snames)]
        local from = ""..sname
        local chosen_what = what_trade[math.random(#what_trade)]
        local chosen_where = where_trade[math.random(#where_trade)]
        local news_text = "%c[255,238,155,23]".. from ..":\\n%c[default]".. trade_maseges .. chosen_what .. " " .. chosen_where
        db.actor:give_game_news(news_text, "ui\\ui_iconsTotal", Frect():set(0,47,83,47), 0, 13000)
    end
end

