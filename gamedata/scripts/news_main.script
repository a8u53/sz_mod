function show_news_freedom()
    local m_post_freedom = ""
    if math.random() < post_message_freedom then
        m_post_freedom = freedom_news[math.random(#freedom_news)]
    end
    if (m_post_freedom ~= "") then
        local news_text = m_post_freedom
        local snd = xr_sound.get_safe_sound_object([[device\pda\pda_tip]])
        db.actor:give_game_news(news_text, "ui\\ui_iconsTotal", Frect():set(498,94,83,47), 0, 13000)
    end
end

-- Полностью рандомные
function show_news_random()
    local news_random = ""
    if math.random() < post_message_random then
        news_random = news_when[math.random(#news_when)]
    end
    if (news_random ~= "") then
        local sname = snames[math.random(#snames)]
        local from = ""..sname
        local where = where_trade[math.random(#where_trade)]
        local text = news_text[math.random(#news_text)]
        local news_text = "%c[255,238,155,23]".. from ..":\\n%c[default]".. news_random .. where .. text
        db.actor:give_game_news(news_text, "ui\\ui_iconsTotal", Frect():set(498,141,83,47), 0, 13000)
    end
end


