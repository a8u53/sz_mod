function bind(obj)
	printf("_bp: monster.bind: name='%s', id='%d'", obj:name(), obj:id())

	-- Äëÿ ñïàóíà
	--xr_spawner.spawn_client(obj)

	local new_binder = generic_object_binder(obj)
	obj:bind_object(new_binder)
end

------------------------------------------------------------------------------------
class "generic_object_binder" (object_binder)

function generic_object_binder:__init(obj) super(obj)
	self.loaded = false
end 

function generic_object_binder:reload(section)
	object_binder.reload(self, section)
end

function generic_object_binder:reinit()
	object_binder.reinit(self)

	-- Ó òîðãîâöà íåò ïîääåðæêè ïåðåìåùåíèÿ
	if self.object:clsid() ~= clsid.script_trader then
		self.object:set_patrol_extrapolate_callback(generic_object_binder.extrapolate_callback, self)
	end

	db.storage[self.object:id()] = { }

	self.st = db.storage[self.object:id()]

	-- Blood pool state (same growth sequence as stalker corpses).
	self.blood_pool_bone = nil
	self.blood_pool_time = nil
	self.blood_pool_growth_step = nil
	self.blood_pool_done = false

	self.object:set_callback(callback.patrol_path_in_point, self.waypoint_callback, self)
	self.object:set_callback(callback.hit,					self.hit_callback,		self)
	self.object:set_callback(callback.death,				self.death_callback,	self)
	self.object:set_callback(callback.use_object, self.use_callback, self)
end

function generic_object_binder:update(delta)
  object_binder.update(self, delta)

  -- Gradually grow one blood pool after the mutant has fallen.
  if self.blood_pool_time and time_global() >= self.blood_pool_time then
    if self.object then
      if not self.blood_pool_growth_step then
        self.blood_pool_growth_step = 1
      end

      local scale = self.blood_pool_growth_step / 120
      self.object:place_blood_pool(self.blood_pool_bone or 65535, scale)

      if self.blood_pool_growth_step < 120 then
        self.blood_pool_growth_step = self.blood_pool_growth_step + 1
        self.blood_pool_time = time_global() + 100
      else
        self.blood_pool_time = nil
        self.blood_pool_growth_step = nil
        self.blood_pool_done = true
      end
    else
      self.blood_pool_time = nil
    end
  end
--  printf("_bp: generic_object_binder: UPDATE [name='%s' time=%d]",
--    self.object:name(), time_global())
  -- Àïäåéò òîðãîâëè
  if self.object:clsid() == clsid.script_trader then
    trade_manager.update(self.object)
  end
  if self.object:alive() then
    if self.object:is_talk_enabled() then
      self.object:set_tip_text("character_use")
    else
      self.object:set_tip_text("")
    end
           --/#+# 'çàñîñ êðîâîñîñà' --------------------------------------------------
    if self.object:clsid() == clsid.bloodsucker_s and self.object.health > 0.25 then
      local oTarget = self.object:get_enemy()
      if oTarget and IsStalker(oTarget) and self.object:see(oTarget) then
        --/ åñëè ó êðîâîñîñà åñòü âðàã/öåëü è êðîâîñîñ åãî âèäèò òî ...
        local iDist = self.object:position():distance_to(oTarget:position())
        if iDist <= 3 then --/ äèñòàíöèÿ äëÿ àíèìàöèè 'çàñîñà'
          local iTime = time_global()
          --/ òàéìåð äëÿ àíèìàöèè è õèòà ...
          if (self.timer_anim or 0) < iTime then
            self.timer_anim = iTime + 2000 --/ òàéìåð àíèìàöèè ~ 2 ñåê
            if self.object:animation_count() > 0 then
              self.object:clear_animations()
            end
            self.object:add_animation("vampire_0", true) --/ âàðèàíòû: "vampire_0" | "idle"
            --/ îçâó÷êà 'çàñîñà'
            local oSnd = sound_object("monsters\\bloodsucker\\vampire_sucking")
            oSnd:play_no_feedback(self.object, sound_object.s3d, 0, vector(0, 0, 0), 1.0)
          end
          --/ õèò æåðòâå (ïðèòÿãèâàåì)
          if (self.timer_hit or 0) < iTime and (self.timer_anim and self.timer_anim + 2000 >= iTime) then
            self.timer_hit = iTime + 800 --/ òàéìåð õèòà ~ 0.5 ñåê
            local vDir = self.object:direction() --/ âåêòîð êðîâîñîñà
            local vDirHit = vector_rotate_y(vDir,179.0)
            local h = hit()
            h.draftsman = self.object
            h.direction = vDirHit --/ íàïðàâëåíèå õèòà
            h:bone("bip01_spine") --/ äëÿ ó÷åòà 'áðîíè'
            h.power     = 0.20
            level.add_pp_effector("fire_hit.ppe", 3000, false)
            h.impulse   = 120/iDist --/ ÷åì áëèæå - òåì ñèëüíåå 'çàñîñ'
            h.type      = hit.wound --hit.strike
            oTarget:hit(h) --/ íàíîñèì õèò æåðòâå
            --/ ðàçâîðîò æåðòâû íà êðîâîñîñà. TODO: òðåáóåò äîðàáîòêè/çàìåíû!
             if oTarget:id() == db.actor:id() then --/ æåðòâà == àêòîð? (à íóæíî?)
              oTarget:set_actor_direction(vDirHit:getH())
            end
          end
        end
      end
    end
    --/<-----------------------------------------------------------------------
  else
    self.object:set_tip_text_default()
  end
  if self.st.active_section ~= nil then
    xr_logic.issue_event(self.object, self.st[self.st.active_scheme], "update", delta)
  end
end

function generic_object_binder:extrapolate_callback()
	local cur_pt = self.object:get_current_point_index()

    if self.object:get_script ()	== false then 
       return false
    end    
    
	if patrol(self.object:patrol()):flags(cur_pt):get() == 0 then
		--printf("_bp: generic_object_binder: extrapolate_callback: cur_pt = %d: true", cur_pt)
		return true
	end
	--printf("_bp: generic_object_binder: extrapolate_callback: cur_pt = %d: false", cur_pt)
	return false
end

function generic_object_binder:use_callback(obj, who)
end

function generic_object_binder:waypoint_callback(obj, action_type, index)
	if self.st.active_section ~= nil then
		xr_logic.issue_event(self.object, self.st[self.st.active_scheme], "waypoint_callback", obj, action_type, index)
	end
end

function generic_object_binder:death_callback(victim, who)
	-- Start the blood pool even when the hit callback supplied no bone index.
	if not self.blood_pool_done and not self.blood_pool_time then
		self.blood_pool_bone = self.blood_pool_bone or 65535
		self.blood_pool_time = time_global() + 1500
	end

	if who:id() == db.actor:id() then
		xr_statistic.addKillCount(self.object)
	end

	if self.st.mob_death then
		xr_logic.issue_event(self.object, self.st.mob_death, "death_callback", victim, who)
	end

	if self.st.active_section then
		xr_logic.issue_event(self.object, self.st[self.st.active_scheme], "death_callback", victim, who)
	end

	smart_terrain.on_death( self.object:id() )

	-- Rostok mutant arena: finish the current round and unlock the next opponent.
	if db.actor then
		local section = self.object:section()
		if section == "pseudodog_arena" then
			db.actor:disable_info_portion("bar_arena_spawn_monstr")
			db.actor:disable_info_portion("bar_arena_pseudodog_choosen")
			db.actor:give_info_portion("bar_arena_pseudodog_defeated")
			db.actor:give_info_portion("bar_arena_monstr_dead")
		elseif section == "snork_arena" then
			db.actor:disable_info_portion("bar_arena_spawn_monstr")
			db.actor:disable_info_portion("bar_arena_snork_choosen")
			db.actor:give_info_portion("bar_arena_snork_defeated")
			db.actor:give_info_portion("bar_arena_monstr_dead")
		elseif section == "bloodsucker_arena" then
			db.actor:disable_info_portion("bar_arena_spawn_monstr")
			db.actor:disable_info_portion("bar_arena_bloodsucker_choosen")
			db.actor:give_info_portion("bar_arena_bloodsucker_defeated")
			db.actor:give_info_portion("bar_arena_monstr_dead")
		elseif section == "burer_arena" then
			db.actor:disable_info_portion("bar_arena_spawn_monstr")
			db.actor:disable_info_portion("bar_arena_burer_choosen")
			db.actor:give_info_portion("bar_arena_burer_defeated")
			db.actor:give_info_portion("bar_arena_monstr_dead")
		end
	end

	--' Íàíîñèì íåáîëüøîé èìïóëüñ âïåðåä.
	local h = hit()
	h.draftsman = self.object
	h.type = hit.fire_wound
	h.direction = db.actor:position():sub(self.object:position())
	h:bone("pelvis")
	h.power = 1
	h.impulse = 10
	self.object:hit(h)

end

function generic_object_binder:hit_callback(obj, amount, local_direction, who, bone_index)
	if amount > 0 and self.object:alive() then
		self.blood_pool_bone = bone_index or self.blood_pool_bone or 65535
	end
--	printf("HIT_CALLBACK: [%s] amount[%s]", obj:name(), amount)
	if self.st.hit then
		xr_logic.issue_event(self.object, self.st.hit, "hit_callback", obj, amount, local_direction, who, bone_index)
	end
	if sz_blood and sz_blood.check_blood then
		sz_blood.check_blood(obj, who, amount)
	end
end

function generic_object_binder:net_spawn(sobject)
	if not object_binder.net_spawn(self, sobject) then
		return false
	end

	db.add_obj(self.object)

	if sz_dynmusic and sz_dynmusic.register_combatant then
		sz_dynmusic.register_combatant(self.object)
	end

	xr_gulag.setup_gulag_and_logic_on_spawn( self.object, self.st, sobject, modules.stype_mobile, self.loaded )

	return true
end

function generic_object_binder:net_destroy()
	if sz_dynmusic and sz_dynmusic.unregister_combatant then
		sz_dynmusic.unregister_combatant(self.object)
	end

	self.object:set_callback(callback.death,				nil)
	self.object:set_callback(callback.patrol_path_in_point, nil)
	self.object:set_callback(callback.hit,					nil)
    self.object:set_callback(callback.use_object, nil)
	
	local st = db.storage[self.object:id()]
	if st and st.active_scheme then
		xr_logic.issue_event(self.object, st[st.active_scheme], "net_destroy")
	end
	
	db.del_obj(self.object)
	db.storage[self.object:id()] = nil

	object_binder.net_destroy(self)
end 

function generic_object_binder:reload(section)
	object_binder.reload(self, section)
	--printf("generic_object_binder:reload(): self.object:name()='%s'", self.object:name())
end

function generic_object_binder:net_save_relevant()
	--printf("generic_object_binder:net_save_relevant(): self.object:name()='%s'", self.object:name())
	return true
end

function generic_object_binder:save(packet)
	printf("generic_object_binder:save(): self.object:name()='%s'", self.object:name())
	object_binder.save(self, packet)

	xr_logic.save_obj(self.object, packet)
	if self.object:clsid() == clsid.script_trader then
		trade_manager.save(self.object, packet)
	end
end

function generic_object_binder:load(reader)
	self.loaded = true

	printf("generic_object_binder:load(): self.object:name()='%s'", self.object:name())
	object_binder.load(self, reader)

	if reader:r_eof() then
		abort("SAVE FILE IS CORRUPT")
	end

	xr_logic.load_obj(self.object, reader)
	if self.object:clsid() == clsid.script_trader then
		trade_manager.load(self.object, reader)
	end
end
