-- ============================================================
-- sz_healing.script
-- Плавное лечение (тик 100 мс) + плавное мигание статиков
-- ============================================================

-- ============================================================
-- НАСТРОЙКИ (сколько добавляется за 1 секунду)
-- ============================================================
local RATE_HEALTH    = 0.06
local RATE_RADIATION = -0.10
local RATE_POWER     = 0.05

-- Настройки тиков (100 мс = 10 раз в секунду для плавности лечения)
local TICK_INTERVAL = 100 
local TICK_HEALTH    = RATE_HEALTH / 10
local TICK_RADIATION = RATE_RADIATION / 10
local TICK_POWER     = RATE_POWER / 10

-- Настройки плавного мигания
local FADE_TIME   = 3000      -- За 3 секунды до конца начинаем мигать

-- ============================================================
-- ТАБЛИЦА ПРЕДМЕТОВ
-- ============================================================
local ITEMS = {
    ["medkit"] = { time = 5000, static = "hud_heal_medkit", health = true, radiation = false, power = false },
    ["medkit_army"] = { time = 15000, static = "hud_heal_medkit", health = true, radiation = false, power = false },
    ["medkit_scientic"] = { time = 30000, static = "hud_heal_medkit", static_rad = "hud_heal_antirad", health = true, radiation = true, power = false },
    ["antirad"] = { time = 10000, static = "hud_heal_antirad", health = false, radiation = true, power = false },
    ["antirad_pills"] = { time = 5000, static = "hud_heal_antirad", health = false, radiation = true, power = false },
    ["painkiller_1"] = { time = 2000, static = "hud_heal_medkit", health = true, radiation = false, power = false },
    ["painkiller_2"] = { time = 2000, static = "hud_heal_medkit", health = true, radiation = false, power = false },
    ["painkiller_3"] = { time = 2000, static = "hud_heal_medkit", health = true, radiation = false, power = false },
    ["painkiller_4"] = { time = 2000, static = "hud_heal_medkit", health = true, radiation = false, power = false },
    ["energy_drink"] = { time = 45000, static = "hud_heal_energy", health = false, radiation = false, power = true },
    ["voda"] = { time = 15000, static = "hud_heal_energy", health = false, radiation = false, power = true },
    ["vodka"] = { time = 10000, static = "hud_heal_antirad", health = false, radiation = true, power = false },
}

-- ============================================================
-- ЛОГИКА
-- ============================================================

local active_effects = {}
local static_base_positions = {}
local STATIC_LAYOUT_GAP = 12 -- промежуток между иконками при нескольких активных эффектах

function is_heal_item(section)
    return ITEMS[section] ~= nil
end

local function get_static_wnd(hud, static_name)
    if not hud or not static_name then return nil end
    local static = hud:GetCustomStatic(static_name)
    if not static then
        hud:AddCustomStatic(static_name, true)
        static = hud:GetCustomStatic(static_name)
    end
    if not static then return nil end
    local wnd = static.wnd and static:wnd() or nil
    if wnd and not static_base_positions[static_name] then
        -- Запоминаем исходную позицию из HUD XML, чтобы одиночный статик
        -- всегда возвращался ровно на своё штатное место.
        static_base_positions[static_name] = {
            x = wnd:GetPosLeft(),
            y = wnd:GetPosTop()
        }
    end
    return wnd
end

local function update_static_layout()
    local hud = get_hud()
    if not hud then return end

    -- Собираем уникальные статики, относящиеся к активным эффектам.
    local names = {}
    local seen = {}
    for _, effect in pairs(active_effects) do
        if effect.static_name and not seen[effect.static_name] then
            seen[effect.static_name] = true
            table.insert(names, effect.static_name)
        end
        if effect.static_rad and not seen[effect.static_rad] then
            seen[effect.static_rad] = true
            table.insert(names, effect.static_rad)
        end
    end

    table.sort(names)
    local count = #names
    if count == 0 then return end

    local windows = {}
    for i, name in ipairs(names) do
        local static = hud:GetCustomStatic(name)
        local wnd = static and static.wnd and static:wnd() or nil
        local base = static_base_positions[name]
        if wnd and base then
            windows[i] = { name = name, wnd = wnd, base = base, width = wnd:GetWidth() }
        end
    end

    -- Один активный статик: никаких сдвигов, строго его исходные координаты.
    if count == 1 and windows[1] then
        windows[1].wnd:SetWndPos(windows[1].base.x, windows[1].base.y)
        return
    end

    -- При нескольких статических индикаторах выстраиваем их в ряд,
    -- центрируя ряд относительно исходной позиции первого по сортировке.
    local anchor = windows[1]
    if not anchor then return end

    local total_width = 0
    local valid_count = 0
    for _, entry in ipairs(windows) do
        if entry then
            total_width = total_width + entry.width
            valid_count = valid_count + 1
        end
    end
    if valid_count == 0 then return end
    total_width = total_width + STATIC_LAYOUT_GAP * (valid_count - 1)

    local x = anchor.base.x - (total_width - anchor.width) / 2
    for _, entry in ipairs(windows) do
        if entry then
            entry.wnd:SetWndPos(x, anchor.base.y)
            x = x + entry.width + STATIC_LAYOUT_GAP
        end
    end
end

local function remove_static(hud, static_name)
    if hud and static_name and hud:GetCustomStatic(static_name) then
        hud:RemoveCustomStatic(static_name)
    end
end

-- Безопасная установка прозрачности (без bit_lshift)
local function set_static_alpha(wnd, alpha)
    if not wnd then return end
    if alpha < 0 then alpha = 0 end
    if alpha > 255 then alpha = 255 end
    -- 0xAARRGGBB. Умножение на 16777216 (2^24) сдвигает альфу в старший байт.
    local color = alpha * 16777216 + 0xFFFFFF
    wnd:SetColor(color)
end

function reset_healing()
    local hud = get_hud()
    for key, effect in pairs(active_effects) do
        -- Отменяем таймеры лечения
        if effect.delay_func then 
            level.remove_call(effect.delay_func, effect.fire_func) 
        end
        -- Отменяем таймеры анимации
        if effect.anim_delay_func then 
            level.remove_call(effect.anim_delay_func, effect.anim_fire_func) 
        end
        -- Удаляем статики
        remove_static(hud, effect.static_name)
        if effect.static_rad then remove_static(hud, effect.static_rad) end
    end
    active_effects = {}
end

function use_item(obj)
    if not obj then return end
    local section = obj:section()
    local item_data = ITEMS[section]
    
    if not item_data then return end
    
    local actor = db.actor
    if not actor or not actor:alive() then return end

    local key = item_data.static
    local hud = get_hud()

    -- 1. Если такой эффект уже есть, ПОЛНОСТЬЮ удаляем старый (таймеры + статики)
    if active_effects[key] then
        if active_effects[key].delay_func then 
            level.remove_call(active_effects[key].delay_func, active_effects[key].fire_func) 
        end
        if active_effects[key].anim_delay_func then
            level.remove_call(active_effects[key].anim_delay_func, active_effects[key].anim_fire_func)
        end
        
        remove_static(hud, active_effects[key].static_name)
        if active_effects[key].static_rad then 
            remove_static(hud, active_effects[key].static_rad) 
        end
        active_effects[key] = nil
    end

    -- 2. Создаем новый эффект
    local effect = {
        static_name = item_data.static,
        static_rad = item_data.static_rad,
        health = item_data.health,
        radiation = item_data.radiation,
        power = item_data.power,
        time_left = item_data.time,
        is_visible = true
    }

    -- 3. Показываем новые статики и сбрасываем альфу на 255
    local wnd = get_static_wnd(hud, effect.static_name)
    if wnd then 
        wnd:Show(true) 
        set_static_alpha(wnd, 255)
    end
    if effect.static_rad then
        local wnd_rad = get_static_wnd(hud, effect.static_rad)
        if wnd_rad then 
            wnd_rad:Show(true) 
            set_static_alpha(wnd_rad, 255)
        end
    end

    -- --- ТАЙМЕР ЛЕЧЕНИЯ ---
    local function tick_fire()
        if not active_effects[key] or not db.actor or not db.actor:alive() then
            return
        end
        
        -- Применяем эффекты
        if effect.health then db.actor.health = TICK_HEALTH end
        if effect.radiation then 
            if db.actor.radiation > 0 then db.actor.radiation = TICK_RADIATION end
        end
        if effect.power then db.actor.power = TICK_POWER end
        
        -- Уменьшаем время
        effect.time_left = effect.time_left - TICK_INTERVAL
        
        -- Завершение
        if effect.time_left <= 0 then
            local hud2 = get_hud()
            remove_static(hud2, effect.static_name)
            if effect.static_rad then remove_static(hud2, effect.static_rad) end
            active_effects[key] = nil
            update_static_layout()
            return
        end
        
        -- --- ЗАПУСК АНИМАЦИИ МИГАНИЯ ---
        local anim_start = time_global()
        local function anim_fire()
            if not active_effects[key] or effect.time_left <= 0 then return end
            
            local hud2 = get_hud()
            local w = get_static_wnd(hud2, effect.static_name)
            local w_rad = get_static_wnd(hud2, effect.static_rad)
            
            if effect.time_left <= FADE_TIME then
                local progress = 1.0 - (effect.time_left / FADE_TIME)
                if progress < 0 then progress = 0 end
                if progress > 1.0 then progress = 1.0 end
                
                local blink_speed = 6
                local wave = math.abs(math.sin(progress * math.pi * blink_speed))
                local alpha = math.floor(50 + (205 * wave))
                
                if w then set_static_alpha(w, alpha) end
                if w_rad then set_static_alpha(w_rad, alpha) end
            else
                if w then set_static_alpha(w, 255) end
                if w_rad then set_static_alpha(w_rad, 255) end
            end
            
            local now = time_global()
            local function d() return (time_global() - now) >= 16 end
            level.add_call(d, anim_fire)
            
            -- Сохраняем ссылки на анимацию для корректной отмены
            effect.anim_delay_func = d
            effect.anim_fire_func = anim_fire
        end
        
        -- Запускаем первый кадр анимации
        local function d_anim() return (time_global() - anim_start) >= 16 end
        level.add_call(d_anim, anim_fire)
        
        -- Сохраняем ссылки на первый кадр анимации
        effect.anim_delay_func = d_anim
        effect.anim_fire_func = anim_fire
        
        -- Перезапускаем таймер лечения на 100 мс
        local start = time_global()
        local function d_tick() return (time_global() - start) >= TICK_INTERVAL end
        level.add_call(d_tick, tick_fire)
        
        -- Сохраняем ссылки на следующий тик лечения
        effect.delay_func = d_tick
        effect.fire_func = tick_fire
    end

    -- Запускаем первый тик лечения
    local start = time_global()
    local function initial_delay() return (time_global() - start) >= TICK_INTERVAL end
    level.add_call(initial_delay, tick_fire)
    
    -- Сохраняем ссылки на первый тик
    effect.delay_func = initial_delay
    effect.fire_func = tick_fire

    active_effects[key] = effect
    update_static_layout()
end

-- ============================================================
-- СОХРАНЕНИЕ И ЗАГРУЗКА ЭФФЕКТОВ
-- ============================================================

function save_healing_state()
    local actor = db.actor
    if not actor then return end
    
    local id = actor:id()
    if not db.storage[id] then db.storage[id] = {} end
    if not db.storage[id].pstor then db.storage[id].pstor = {} end
    
    local pstor = db.storage[id].pstor
    local saved_effects = {}
    
    for key, effect in pairs(active_effects) do
        table.insert(saved_effects, {
            key = key,
            static_name = effect.static_name,
            static_rad = effect.static_rad,
            health = effect.health,
            radiation = effect.radiation,
            power = effect.power,
            time_left = effect.time_left
        })
    end
    
    pstor["sz_healing_active"] = saved_effects
end

function load_healing_state()
    local actor = db.actor
    if not actor then return end
    
    local id = actor:id()
    if not db.storage[id] or not db.storage[id].pstor then return end
    
    local pstor = db.storage[id].pstor
    local saved_effects = pstor["sz_healing_active"]
    
    if not saved_effects then return end
    
    -- Очищаем текущие эффекты (на всякий случай)
    reset_healing()
    
    for _, data in ipairs(saved_effects) do
        -- Восстанавливаем эффект
        local key = data.key
        local hud = get_hud()
        
        local effect = {
            static_name = data.static_name,
            static_rad = data.static_rad,
            health = data.health,
            radiation = data.radiation,
            power = data.power,
            time_left = data.time_left, -- Оставшееся время!
            is_visible = true
        }
        
        -- Показываем статики
        local wnd = get_static_wnd(hud, effect.static_name)
        if wnd then wnd:Show(true) end
        if effect.static_rad then
            local wnd_rad = get_static_wnd(hud, effect.static_rad)
            if wnd_rad then wnd_rad:Show(true) end
        end
        
        -- Запускаем таймеры заново (логика аналогична use_item)
        local function tick_fire()
            if not active_effects[key] or not db.actor or not db.actor:alive() then return end
            
            if effect.health then db.actor.health = TICK_HEALTH end
            if effect.radiation then 
                if db.actor.radiation > 0 then db.actor.radiation = TICK_RADIATION end
            end
            if effect.power then db.actor.power = TICK_POWER end
            
            effect.time_left = effect.time_left - TICK_INTERVAL
            
            if effect.time_left <= 0 then
                local hud2 = get_hud()
                remove_static(hud2, effect.static_name)
                if effect.static_rad then remove_static(hud2, effect.static_rad) end
                active_effects[key] = nil
                update_static_layout()
                return
            end
            
            -- Анимация (как в use_item)
            local anim_start = time_global()
            local function anim_fire()
                if not active_effects[key] or effect.time_left <= 0 then return end
                local hud2 = get_hud()
                local w = get_static_wnd(hud2, effect.static_name)
                local w_rad = get_static_wnd(hud2, effect.static_rad)
                
                if effect.time_left <= FADE_TIME then
                    local progress = 1.0 - (effect.time_left / FADE_TIME)
                    if progress < 0 then progress = 0 end
                    if progress > 1.0 then progress = 1.0 end
                    local blink_speed = 6
                    local wave = math.abs(math.sin(progress * math.pi * blink_speed))
                    local alpha = math.floor(50 + (205 * wave))
                    if w then set_static_alpha(w, alpha) end
                    if w_rad then set_static_alpha(w_rad, alpha) end
                else
                    if w then set_static_alpha(w, 255) end
                    if w_rad then set_static_alpha(w_rad, 255) end
                end
                
                local now = time_global()
                local function d() return (time_global() - now) >= 16 end
                level.add_call(d, anim_fire)
                effect.anim_delay_func = d
                effect.anim_fire_func = anim_fire
            end
            
            local function d_anim() return (time_global() - anim_start) >= 16 end
            level.add_call(d_anim, anim_fire)
            effect.anim_delay_func = d_anim
            effect.anim_fire_func = anim_fire
            
            local start = time_global()
            local function d_tick() return (time_global() - start) >= TICK_INTERVAL end
            level.add_call(d_tick, tick_fire)
            effect.delay_func = d_tick
            effect.fire_func = tick_fire
        end
        
        local start = time_global()
        local function initial_delay() return (time_global() - start) >= TICK_INTERVAL end
        level.add_call(initial_delay, tick_fire)
        effect.delay_func = initial_delay
        effect.fire_func = tick_fire
        
        active_effects[key] = effect
    end
    update_static_layout()
end