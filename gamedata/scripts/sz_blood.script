-- ============================================================
-- sz_blood.script
-- Брызги крови (полный залп, кулдаун до исчезновения)
-- ============================================================

local BLOOD_DISTANCE = 3.0
-- Кулдаун больше не нужен, так как мы ждем исчезновения всех капель,
-- но оставим маленький (50 мс), чтобы за один кадр не спавнилось дважды
local BLOOD_COOLDOWN = 50 
local BLOOD_LIFETIME = 3000      -- Время жизни капли (мс)
local last_blood_time = 0

local POOL_SIZE = 30
local DROPS_PER_HIT = 30         -- Показываем ВСЕ 30 капель за раз!

local blood_pool = {}
local active_drops = {}
local statics_initialized = false

-- Загрязнение конкретных предметов. Ключ — runtime ID предмета, не слот.
-- Пока хранится в памяти Lua; сериализацию в savegame добавим отдельным этапом.
local ITEM_BLOOD_DECAY_PER_SEC = 0.012
local item_blood_state = {}

local function get_item_id(item)
    if not item then return nil end
    local ok, id = pcall(function() return item:id() end)
    if ok then return id end
    return nil
end

-- Множитель загрязнения по секции выбранного боеприпаса.
-- Индекс get_ammo_type() соответствует порядку ammo_class в секции оружия.
local ammo_blood_multipliers = {
    -- 9x18 — базовый калибр
    ammo_9x18_fmj = 1.0,
    ammo_9x18_pbp = 1.0,
    ammo_9x18_pmm = 1.0,

    -- Пистолетные промежуточные калибры
    ammo_9x19_fmj = 1.5,
    ammo_9x19_pbp = 1.5,
    ["ammo_7.62x25"] = 1.5,
    ["ammo_11.43x23_fmj"] = 2.0,
    ["ammo_11.43x23_hydro"] = 2.0,

    -- Малокалиберные винтовочные
    ["ammo_5.7x28_fmj"] = 2.5,
    ["ammo_5.7x28_ap"] = 2.5,
    ["ammo_5.45x39_fmj"] = 3.0,
    ["ammo_5.45x39_ap"] = 3.0,
    ["ammo_5.45x39_exp"] = 3.0,
    ["ammo_5.56x45_ss190"] = 3.0,
    ["ammo_5.56x45_ap"] = 3.0,

    -- Крупные винтовочные / специальные
    ammo_9x39_pab9 = 4.0,
    ammo_9x39_ap = 4.0,
    ammo_9x39_sp5 = 4.0,
    ["ammo_7.62x54r"] = 5.0,
    ["ammo_7.62x54_7h1"] = 5.0,
    ["ammo_7.62x54_ap"] = 5.0,
    ["ammo_7.62x54_7h14"] = 5.0,
    ammo_gauss = 6.0,

    -- Дробовые патроны и крупные снаряды
    ammo_12x70_buck = 5.5,
    ammo_12x70_kar = 5.5,
    ammo_12x76_dart = 5.5,
    ammo_12x76_zhekan = 5.5,
    ammo_12x76_zhekan_heli = 5.5,

    -- Гранатомётные боеприпасы
    ["ammo_og-7b"] = 6.0,
    ["ammo_vog-25p"] = 5.0,
    ["ammo_vog-25"] = 5.0,
    ammo_m209 = 5.0,
    ["ammo_vog-25_termo"] = 5.0,
    ["ammo_vog-25_svet"] = 5.0
}

local ammo_class_cache = {}

local function get_ammo_blood_multiplier(weapon)
    if not weapon then return 1.0 end

    local ok, weapon_section = pcall(function() return weapon:section() end)
    if not ok or not weapon_section then return 1.0 end

    local ammo_classes = ammo_class_cache[weapon_section]
    if not ammo_classes then
        local ok_ini, ini = pcall(system_ini)
        if not ok_ini or not ini then return 1.0 end

        local ok_value, ammo_class = pcall(function()
            return ini:r_string(weapon_section, "ammo_class")
        end)
        if not ok_value or type(ammo_class) ~= "string" then return 1.0 end

        ammo_classes = {}
        for section in string.gmatch(ammo_class, "[^,]+") do
            section = string.gsub(section, "^%s*(.-)%s*$", "%1")
            ammo_classes[#ammo_classes + 1] = section
        end
        ammo_class_cache[weapon_section] = ammo_classes
    end

    local ok_type, ammo_type = pcall(function() return weapon:get_ammo_type() end)
    if not ok_type or type(ammo_type) ~= "number" then return 1.0 end

    -- В OGSR m_ammoType — индекс с нуля.
    local ammo_section = ammo_classes[ammo_type + 1]
    if not ammo_section then return 1.0 end

    return ammo_blood_multipliers[ammo_section] or 1.0
end

local function add_item_blood(item, amount, multiplier)
    local id = get_item_id(item)
    if not id then return end
    local now = time_global()
    local state = item_blood_state[id]
    if not state then
        state = { amount = 0, last_update = now, item_id = id }
        item_blood_state[id] = state
    end
    local elapsed = math.max(0, now - (state.last_update or now)) / 1000
    state.amount = math.max(0, (state.amount or 0) - elapsed * ITEM_BLOOD_DECAY_PER_SEC)
    local base_gain = math.min(0.35, math.max(0.05, (amount or 0) * 0.15))
    state.amount = math.min(1, state.amount + base_gain * (multiplier or 1.0))
    state.last_update = now
    state.last_hit = now
end

-- Публичный доступ для будущего HUD/shader bridge и отладки.
function get_item_blood(item_id)
    local state = item_blood_state[item_id]
    if not state then return 0 end

    local now = time_global()
    local elapsed = math.max(0, now - (state.last_update or now)) / 1000
    local amount = math.max(0, (state.amount or 0) - elapsed * ITEM_BLOOD_DECAY_PER_SEC)

    if amount <= 0 then
        item_blood_state[item_id] = nil
        return 0
    end

    return amount
end

-- Передаём два независимых канала вектору ssfx_hud_blood_params:
-- X — руки/костюм, Y — текущее оружие. Z и W пока не используются.
local function set_hud_blood_channels(hands_value, weapon_value)
    hands_value = math.max(0, math.min(1, hands_value or 0))
    weapon_value = math.max(0, math.min(1, weapon_value or 0))

    local command = string.format(
        "ssfx_hud_blood_params %.2f,%.2f,0,0",
        hands_value,
        weapon_value
    )

    -- В OGSR консоль получается через get_console(), а не из глобальной
    -- переменной console. Такой же способ используется в sz_helmet_system.
    local ok, console = pcall(get_console)
    if not ok or not console then
        printf("SZ_BLOOD: get_console() unavailable")
        return false
    end

    local executed, err = pcall(function()
        console:execute(command)
    end)

    if not executed then
        printf("SZ_BLOOD: console:execute failed: %s", tostring(err))
        return false
    end

    return true
end

local function get_actor_outfit(actor)
    -- В OGSR стандартный слот костюма — 6. Вызов защищён на случай иной сборки API.
    local ok, item = pcall(function() return actor:item_in_slot(6) end)
    if ok then return item end
    return nil
end

local last_hud_hands_value = nil
local last_hud_weapon_value = nil

local function get_item_blood_value(item)
    local id = get_item_id(item)
    if not id then return 0 end
    return get_item_blood(id)
end

-- Обновляем каналы по текущему экипированному снаряжению.
-- Функция вызывается из update_blood_splatters(), который уже вызывается
-- каждый кадр из actor_binder:update(). Команду консоли шлём только при
-- изменении значения хотя бы на 0.01, чтобы не выполнять её каждый кадр.
local function update_hud_blood_channels()
    local actor = db.actor
    local hands_value = 0
    local weapon_value = 0

    if actor then
        hands_value = get_item_blood_value(get_actor_outfit(actor))
        weapon_value = get_item_blood_value(actor:active_item())
    end

    hands_value = math.floor(hands_value * 100 + 0.5) / 100
    weapon_value = math.floor(weapon_value * 100 + 0.5) / 100

    if hands_value ~= last_hud_hands_value or weapon_value ~= last_hud_weapon_value then
        if set_hud_blood_channels(hands_value, weapon_value) then
            last_hud_hands_value = hands_value
            last_hud_weapon_value = weapon_value
        end
    end
end

-- Функция проверки, есть ли еще активные капли
local function is_any_drop_active()
    for i = 1, POOL_SIZE do
        if active_drops[i] then
            return true
        end
    end
    return false
end

local function set_static_alpha(wnd, alpha)
    if not wnd then return end
    if alpha < 0 then alpha = 0 end
    if alpha > 255 then alpha = 255 end
    local color = alpha * 16777216 + 0xFFFFFF
    wnd:SetColor(color)
end

local function init_statics()
    if statics_initialized then return end
    local hud = get_hud()
    if not hud then return end
    
    for i = 1, POOL_SIZE do
        local name = "hud_blood_drop_" .. i
        local static = hud:GetCustomStatic(name)
        if not static then
            hud:AddCustomStatic(name, true)
            static = hud:GetCustomStatic(name)
        end
        if static then
            local wnd = static:wnd()
            if wnd then
                wnd:Show(false)
            end
        end
        blood_pool[i] = name
    end
    statics_initialized = true
end

local function spawn_blood_splatter()
    init_statics()
    
    local hud = get_hud()
    if not hud then return end

    local screen_w = device().width
    local screen_h = device().height

    -- Создаем список всех индексов и перемешиваем
    local available_indices = {}
    for i = 1, POOL_SIZE do
        table.insert(available_indices, i)
    end

    for i = #available_indices, 2, -1 do
        local j = math.random(i)
        available_indices[i], available_indices[j] = available_indices[j], available_indices[i]
    end

    local drops_to_show = math.min(DROPS_PER_HIT, #available_indices)
    
    for i = 1, drops_to_show do
        local index = available_indices[i]
        local static_name = blood_pool[index]
        
        local static = hud:GetCustomStatic(static_name)
        if static then
            local wnd = static:wnd()
            if wnd then
                local x = math.random(0, screen_w - 32)
                local y = math.random(0, screen_h - 32)
                
                local speed_y = math.random(60, 95)
                
                wnd:SetWndPos(x, y)
                wnd:Show(true)
                set_static_alpha(wnd, 255)
                
                active_drops[index] = {
                    expire_time = time_global() + BLOOD_LIFETIME,
                    start_time = time_global(),
                    start_x = x,
                    start_y = y,
                    speed_y = speed_y,
                    wnd = wnd,
                    index = index
                }
            end
        end
    end
end

function update_blood_splatters()
    -- Обновляем раздельные каналы даже тогда, когда экранных капель сейчас нет.
    update_hud_blood_channels()

    if not statics_initialized then return end
    local now = time_global()
    
    for i = 1, POOL_SIZE do
        local drop = active_drops[i]
        if drop then
            local wnd = drop.wnd
            if not wnd then
                active_drops[i] = nil
            else
                local elapsed = now - drop.start_time
                local progress = elapsed / BLOOD_LIFETIME
                
                if progress >= 1.0 then
                    wnd:Show(false)
                    active_drops[i] = nil
                else
                    local new_y = drop.start_y + (elapsed * drop.speed_y / 1000)
                    wnd:SetWndPos(drop.start_x, new_y)
                    
                    local alpha = math.floor(255 * (1.0 - progress))
                    set_static_alpha(wnd, alpha)
                end
            end
        end
    end
end

function check_blood(obj, who, amount, weapon)
    if not db.actor then return end
    if not obj then return end
    
    -- 1. Проверяем, что урон вообще есть
    if not amount or amount <= 0 then return end
    
    -- 2. Проверяем, что урон нанесен актором (или его пулей)
    -- В OGSR пуля от актора может передаваться как сам актор, либо как объект, у которого owner - актор
    local is_player_damage = false
    
    if who then
        -- Если who - это актор
        if who:id() == db.actor:id() then
            is_player_damage = true
        else
            -- Если who - это пуля или другой объект, проверяем его владельца
            local ok, owner = pcall(function() return who:owner() end)
            if ok and owner and owner:id() == db.actor:id() then
                is_player_damage = true
            end
        end
    end
    
    -- Если урон не от игрока, не показываем кровь
    if not is_player_damage then return end
    
    local now = time_global()
    local actor = db.actor
    local dist = actor:position():distance_to(obj:position())

    if dist <= BLOOD_DISTANCE then
        -- Состояние предметов регистрируется на КАЖДОМ подходящем попадании,
        -- независимо от того, висят ли ещё экранные капли.
        local hit_weapon = weapon or actor:active_item()
        local outfit = get_actor_outfit(actor)
        local ammo_multiplier = get_ammo_blood_multiplier(hit_weapon)
        add_item_blood(hit_weapon, amount, ammo_multiplier)
        add_item_blood(outfit, amount, ammo_multiplier)

        -- Обновляем каналы сразу после попадания: костюм идёт в X,
        -- попавшее в цель оружие — в Y (если оно сейчас активно).
        update_hud_blood_channels()

        -- Экранный залп остаётся с прежним ограничением: один залп до исчезновения капель.
        if is_any_drop_active() then return end
        if now - last_blood_time < BLOOD_COOLDOWN then return end

        spawn_blood_splatter()
        last_blood_time = now
    end
end

function reset_blood()
    local hud = get_hud()
    if hud and statics_initialized then
        for _, name in ipairs(blood_pool) do
            local static = hud:GetCustomStatic(name)
            if static then
                local wnd = static:wnd()
                if wnd then wnd:Show(false) end
            end
        end
    end
    active_drops = {}
    last_blood_time = 0

    -- Заставляем следующий update повторно отправить текущие значения каналов.
    last_hud_hands_value = nil
    last_hud_weapon_value = nil
end
-- Вызывается будущим rain/update bridge: интенсивность дождя 0..1.
-- Стекание/смещение не реализовано здесь: это должно выполняться шейдером.
function update_item_blood_rain(rain_intensity, dt_ms)
    local rain = math.max(0, math.min(1, rain_intensity or 0))
    local dt = math.max(0, dt_ms or 0) / 1000
    if rain <= 0 or dt <= 0 then return end
    for id, state in pairs(item_blood_state) do
        state.amount = math.max(0, (state.amount or 0) - dt * rain * 0.10)
        state.last_update = time_global()
        if state.amount <= 0 then item_blood_state[id] = nil end
    end
end
