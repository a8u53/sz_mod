-- sz_helmet_system.script
-- Этап 1: управление нативным визором OGSR.
-- Поведение перенесено из actor_binder:update без изменения параметров.

local visor_outfit_section = nil

-- Секции костюмов, для которых включается визор.
-- Добавляй новые секции по аналогии: ["имя_секции"] = true
local visor_outfits = {
    ["exo_outfit"] = true,
    ["exo_dolg_outfit"] = true,
	["exo_freedom_outfit"] = true,
    ["svoboda_spec_outfit"] = true,
	["freedom_scientific_outfit"] = true,
	["dolg_heavy_outfit"] = true,
	["dolg_scientific_outfit"] = true,
	["antirad_outfit"] = true,
	["ecolog_outfit"] = true,
	["protection_outfit"] = true,
	["cs_heavy_outfit"] = true,
	["stalker_antigas_outfit"] = true,
	["bandit_antigas_outfit"] = true,
	["military_outfit"] = true,
	["scientific_outfit"] = true,
	["military_stalker_outfit"] = true,
	["military_commander_outfit"] = true,													
}

function update(actor)
    if not actor then
        return
    end

    local outfit = actor:get_current_outfit()
    local outfit_section = outfit and outfit:section() or ""

    -- Выполняем команды только при смене секции костюма.
    if visor_outfit_section == outfit_section then
        return
    end

    local console = get_console()
    if not console then
        return
    end

    visor_outfit_section = outfit_section

    if visor_outfits[outfit_section] then
        console:execute("r2_visor_refl on")
        console:execute("r2_visor_refl_control on")
        console:execute("r2_rain_drops on")
        console:execute("r2_rain_drops_intensity 0.00025")
        console:execute("r2_rain_drops_speed 1.25")
        console:execute("r2_rain_drops_control on")
    else
        console:execute("r2_rain_drops_control off")
        console:execute("r2_rain_drops off")
        console:execute("r2_visor_refl_control off")
        console:execute("r2_visor_refl off")
    end
end