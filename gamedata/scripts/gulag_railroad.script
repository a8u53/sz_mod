function load_job(sj, gname, type, squad, groups)

if type == "faf" then
		t = { section = "logic@ds_kem4_camper1",
			idle = 0,
			prior = 1, state = {0},
			in_rest = "", out_rest = ""
		}
       table.insert(sj, t)	
       t = { section = "logic@ds_kem4_camper2",
			idle = 0,
			prior = 1, state = {0},
			in_rest = "", out_rest = ""
		}
		table.insert(sj, t)	
	   t = { section = "logic@ds_kem4_camper3",
			idle = 0,
			prior = 1, state = {0},
			in_rest = "", out_rest = ""
		}
		table.insert(sj, t)	
  end
end

